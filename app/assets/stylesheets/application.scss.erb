.avatar-with-badge {
  position: relative;
  display: inline-block;
  line-height: 0;
}

.avatar-role-badge {
  position: absolute;
  right: -6px;
  bottom: -4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 84px;
  min-height: 18px;
  padding: 2px 7px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.92);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 0.02em;
  box-shadow: 0 8px 16px rgba(15, 23, 42, 0.16);
  white-space: nowrap;
  text-align: center;
}

.avatar-role-badge--admin {
  background: linear-gradient(135deg, #ef4444, #b91c1c);
}

.avatar-role-badge--owner {
  background: linear-gradient(135deg, #fb923c, #ea580c);
}

.avatar-role-badge--manager {
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
}

// アクティブ状態を示す丸。役職バッジ(右下)と重ならないよう右上に配置する。
// 色は最終ログイン日時に応じた 3 段階（--active 緑 / --semi 黄 / --dormant 灰）。
.avatar-active-dot {
  position: absolute;
  top: -2px;
  right: -2px;
  // 色付き部分を 14px にして視認性を上げる。白フチはこの外側に付ける。
  box-sizing: content-box;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #9ca3af;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.12);
  pointer-events: none;
}

.avatar-active-dot--active {
  background: #22c55e;
}

.avatar-active-dot--semi {
  background: #f59e0b;
}

.avatar-active-dot--dormant {
  background: #9ca3af;
}

// 小サイズアバター（28〜38px）向け。アイコン本体を隠しすぎないよう色付き部分を
// 10px に戻す（白フチ2px・色・判定・aria は通常と共通）。付与判定は
// ApplicationHelper::SMALL_AVATAR_IMAGE_CLASSES（画像クラス＝既存のサイズ情報）。
.avatar-active-dot--small {
  top: -1px;
  right: -1px;
  width: 10px;
  height: 10px;
}

// プロフィール / マイページ等の「大きなユーザー画像」共通枠。
// customer_profile_image_tag ヘルパー専用。枠の寸法・角丸は呼び出し側の
// frame_class（＝既存デザインのサイズ）に任せ、ここでは
// 「縦横比を崩さない中央トリミング」と「枠外へはみ出させない」ことを共通化する。
// customer_avatar_tag が画像を span.avatar-with-badge (inline-block) で包むため、
// 枠として使うときは block 化して割合指定を効かせる。
// 枠 span には overflow:hidden を付けない。この span は役職バッジ・アクティブ丸
// （意図的に枠の外側へはみ出す要素）も内包するため、clip すると欠けてしまう。
// 画像自体は object-fit:cover が img のボックス内に収めるのではみ出さず、
// 角丸・円形のトリミングは .user-profile-image に border-radius:inherit で伝える。
.user-profile-image-frame {
  &.avatar-with-badge {
    display: block;
  }
  position: relative;
  box-sizing: border-box;
  max-width: 100%;
}

.user-profile-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: inherit;
}

// サイズ指定済みの既存コンテナ（.img-container）を枠として使う箇所。
// コンテナの幅・高さいっぱいに枠を広げ、object-fit を効かせる。
.img-container > .user-profile-image-frame {
  width: 100%;
  height: 100%;
}

.stamp-badge{
  display: inline-block;
  background: #fff7ed;
  color: #7c2d12;
  border: 1px solid #fed7aa;
  border-radius: 999px;
  padding: 6px 12px;
  font-weight: 600;
}

// 投稿として表示されるイラストスタンプ（リクエスト/チャット/コメント共通）。
// 親要素を超えず、縦横比を維持し、読み込み失敗時もレイアウトを大きく崩さない。
.stamp-illustration{
  display: block;
  width: 160px;
  max-width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
}

@media (max-width: 575.98px){
  .stamp-illustration{
    width: 128px;
  }
}

// スタンプ選択パネル（app/views/shared/_stamp_picker.html.haml）。
// 既存の常時表示ピッカー（.stamp-picker / .stamp-button：コメント・法人投稿）とは別物。
.stamp-picker-field{
  position: relative;
  margin-top: 10px;
}

.stamp-picker__toggle{
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border: 1px solid #d8dee9;
  border-radius: 999px;
  background: #fff7ed;
  color: #7c2d12;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;

  &:hover{ background: #ffedd5; }
  &:focus-visible{ outline: 2px solid #fb923c; outline-offset: 2px; }
  &[aria-expanded="true"]{ background: #ffedd5; border-color: #fb923c; }
}

.stamp-picker__toggle-icon{
  width: 22px;
  height: 22px;
}

.stamp-picker__panel{
  margin-top: 8px;
  padding: 12px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);

  &[hidden]{ display: none; }
}

.stamp-picker__hint{
  margin: 0 0 8px;
  font-size: 12px;
  color: #6b7280;
}

// 「シンプル / 人物 / どうぶつ」タブ。スマホでも横スクロールを出さないよう
// タブは幅を等分し、ラベルは折り返さない。
.stamp-picker__tabs{
  display: flex;
  gap: 4px;
  margin-bottom: 10px;
  border-bottom: 1px solid #e5e7eb;
}

.stamp-picker__tab{
  flex: 1 1 0;
  min-width: 0;
  padding: 6px 4px;
  border: 0;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: #6b7280;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;

  &:hover{ color: #7c2d12; }
  &:focus-visible{ outline: 2px solid #fb923c; outline-offset: 2px; }
  &[aria-selected="true"]{ color: #7c2d12; border-bottom-color: #fb923c; }
}

.stamp-picker__tabpanel[hidden]{ display: none; }

.stamp-picker__grid{
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
}

@media (max-width: 767.98px){
  .stamp-picker__grid{ grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 400px){
  .stamp-picker__grid{ grid-template-columns: repeat(2, 1fr); }
}

.stamp-picker__cell{ margin: 0; }

.stamp-picker__form{ margin: 0; }

.stamp-choice{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 100%;
  min-height: 96px;
  padding: 8px 4px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background: #ffffff;
  cursor: pointer;
  transition: background-color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;

  &:hover{ background: #f8fafc; border-color: #cbd5e1; }
  &:focus-visible{ outline: 2px solid #fb923c; outline-offset: 2px; }
  &:active{ transform: scale(0.96); background: #fff7ed; }
}

.stamp-choice__img{
  width: 72px;
  height: 72px;
  max-width: 100%;
  object-fit: contain;
  pointer-events: none;
}

.stamp-choice__label{
