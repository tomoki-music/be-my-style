  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-upgrade-cta {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 18px;
  border-radius: 999px;
  border: 1px solid rgba(255, 194, 53, 0.5);
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.95), transparent 18%),
    radial-gradient(circle at 80% 30%, rgba(255, 245, 170, 0.9), transparent 20%),
    linear-gradient(135deg, #ffe97a 0%, #ffbf3c 38%, #ff8c32 100%);
  color: #5c2d00;
  font-weight: 900;
  letter-spacing: 0.03em;
  text-decoration: none;
  box-shadow:
    0 10px 24px rgba(255, 161, 47, 0.34),
    0 0 0 3px rgba(255, 236, 153, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.85);
  overflow: hidden;
  isolation: isolate;
  animation: sparklePulse 2.2s ease-in-out infinite;
}

.lp-btn-disabled {
  opacity: 0.65;
  pointer-events: none;
}

.menu-upgrade-cta::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 20%, rgba(255, 255, 255, 0.6) 48%, transparent 72%);
  transform: translateX(-120%);
  animation: sparkleSweep 3.4s linear infinite;
  z-index: -1;
}

.menu-upgrade-cta:hover {
  color: #4a2400;
  text-decoration: none;
  transform: translateY(-1px) scale(1.02);
  box-shadow:
    0 14px 28px rgba(255, 147, 41, 0.4),
    0 0 0 4px rgba(255, 224, 114, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.menu-upgrade-cta__label {
  white-space: nowrap;
}

.menu-upgrade-cta__spark {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.95);
}

.menu-upgrade-cta--compact {
  padding: 9px 15px;
  font-size: 12px;
}

@keyframes sparklePulse {
  0%, 100% {
    filter: saturate(1) brightness(1);
  }
  50% {
    filter: saturate(1.08) brightness(1.04);
  }
}

@keyframes sparkleSweep {
  0% {
    transform: translateX(-120%);
  }
  100% {
    transform: translateX(120%);
  }
}

@media (max-width: 768px) {
  .feature-gate {
    flex-direction: column;
    align-items: flex-start;

    &__link {
      width: 100%;
    }
  }

  .directory-page-heading {
    text-align: left;
  }

  .directory-page-heading__lead {
    margin-top: 8px;
    font-size: 13px;
  }

  .directory-page-action {
    text-align: left;
  }

  .directory-page-action .btn {
    width: 100%;
  }

  .directory-upgrade-panel {
    width: 100%;
    margin-top: 16px;
  }

  // SP メニュー専用の幅指定。.menu-upgrade-item / .menu-upgrade-cta は
  // PC ゲスト向けナビ（customer-menu-pc__main 内の「料金を見る」）とも共有しているため、
  // ここを無scopeにすると 600〜768px の PC ナビにまで幅が漏れて崩れる。
  // SP ヘッダーメニュー(.customer-menu-sp)配下に限定する。
  .customer-menu-sp .menu-upgrade-item {
    width: 100%;
  }

  // 他の .menu-sp-btn（幅 200px 固定）と横幅・左右位置をそろえる。
  // 以前は 220px 固定 + 親 li の flex-shrink により実際の描画幅が
  // ビューポート幅ごとに 158px 〜 220px の間でばらつき、隣接ボタンと
  // 幅も左右端も揃わずズレて見えていた。
  .customer-menu-sp .menu-upgrade-cta {
    width: 200px;
    max-width: 100%;
    // 他の .menu-sp-btn は margin:5px（header_menu.scss）を持つが、
    // .menu-upgrade-cta にはこれまで margin が無く、その分だけ右端がずれていた。
    margin: 5px;
    flex-shrink: 0;
  }
}
