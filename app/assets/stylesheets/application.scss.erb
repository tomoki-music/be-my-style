  margin-right: 10px;
}

.text-red{
  color: red; 
}

.w100{
  width: 100%;
}

.center{
  text-align: center;
}

.block{
  display: block;
}

.hide{
  display: none;
}

.keep-right{
  text-align: right;
}

.cursor-pointer{
  cursor: pointer;
}

.pagination{
  margin: auto;
  width: 90%;
  display: flex;
  justify-content: center;
}
.pagination span{
  background-color: rgba(158, 158, 158, 0.4);
  text-align: center;
  width: 50px;
  border: solid 1px #344963;
  color: rgb(197, 20, 159);
  transition: .3s;
  -webkit-transform: scale(1);
  transform: scale(1);
}
.pagination span:hover{
  transition: .3s;
  -webkit-transform: scale(1.1);
  transform: scale(1.1);
}
.pagination span a:hover{
  transition: .3s;
  -webkit-transform: scale(1.1);
  transform: scale(1.1);
}

.notifications {
  animation-name: smooth-fadein-out;
  animation-duration: 10s;
  animation-timing-function: ease;
  animation-delay: 0s;
  animation-iteration-count: 1;
  animation-direction: alternate;
  opacity: 0;
  z-index: 10;
  position: fixed;
  top: 200px;
  right: 10px;
  color: $white;
  font-size: 20px;
  text-align: center;
  width: 350px;
  height: 200px;
  border-radius: 10px;
  margin: 0 auto;
  pointer-events: none;
  .notice {
    background-color: #17a2b8;
    border-radius: 10px;
  }
  .alert {
    background-color: red;
    border-radius: 10px;
  }
}

@keyframes smooth-fadein-out {
  0% {opacity: 1;}
  100% {opacity: 0;}
}

