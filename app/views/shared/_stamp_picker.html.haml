-# リクエスト / チャット投稿フォーム用のスタンプ選択パネル。
-# context: :request で event: を、context: :chat で chat_room: / form_url: を受け取る。
-# 各スタンプは独立した mini フォームで、タップ(submit)で即送信する。誤送信防止のため
-# rails-ujs の confirm ダイアログを挟む。パネルの開閉は stamp_picker.js が担当する。
- context = local_assigns.fetch(:context)
- panel_id = "stamp-picker-panel--#{context}"
.stamp-picker-field{ data: { "stamp-picker" => "true" } }
  %button.stamp-picker__toggle{ type: "button", "aria-expanded" => "false", "aria-controls" => panel_id,
      data: { "stamp-picker-toggle" => "true" } }
    %img.stamp-picker__toggle-icon{ src: asset_path("stamps/stamp_like.svg"), alt: "", width: 22, height: 22, "aria-hidden" => "true" }
    %span.stamp-picker__toggle-label スタンプ
  .stamp-picker__panel{ id: panel_id, hidden: true, data: { "stamp-picker-panel" => "true" } }
    %p.stamp-picker__hint スタンプをタップすると送信します
    %ul.stamp-picker__grid{ role: "list" }
      - stamp_choices.each do |key, definition|
        - confirm_text = "「#{definition[:label]}」スタンプを送信します。よろしいですか？"
        - aria_label = "#{definition[:label]}スタンプを送信"
        %li.stamp-picker__cell
          - if context == :request
            = form_with model: [:public, event, Request.new], local: false, html: { class: "stamp-picker__form" } do |f|
              = f.hidden_field :stamp_type, value: key
              %button.stamp-choice{ type: "submit", "aria-label" => aria_label, data: { confirm: confirm_text, "turbolinks" => false } }
                %img.stamp-choice__img{ src: asset_path(definition[:asset]), alt: "", width: 72, height: 72, loading: "lazy" }
                %span.stamp-choice__label= definition[:label]
          - else
            = form_with model: [:public, ChatMessage.new], url: form_url, local: true, html: { class: "stamp-picker__form" } do |f|
              = f.hidden_field :chat_room_id, value: chat_room.id
              = f.hidden_field :stamp_type, value: key
              %button.stamp-choice{ type: "submit", "aria-label" => aria_label, data: { confirm: confirm_text } }
                %img.stamp-choice__img{ src: asset_path(definition[:asset]), alt: "", width: 72, height: 72, loading: "lazy" }
                %span.stamp-choice__label= definition[:label]
