.comment
  = customer_avatar_tag(message.customer, class_name: "user-icon")

  .comment-body
    = customer_profile_name_link(message.customer, { class: "comment-user" }, profile_path: business_customer_path(message.customer))
    - if message.stamped?
      %p.comment-text
        = render "shared/stamp_display", stamp: message
    - else
      %p.comment-text= message.body
