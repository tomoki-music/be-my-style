-# タイムライン / プロジェクトチャット共通の入力欄。
-# f: form builder / placeholder: 入力欄の案内文 / submit_label: 送信ボタンの文言
-# 書式ボタン・プレビュー・添付の選択と取り消しは business/chat_composer.js が担当する。
- f = local_assigns.fetch(:f)
- input_id = "business-composer-#{f.object_name}"
.business-composer{ data: { "business-composer" => "true",
    "preview-url" => business_chat_previews_path,
    "max-files" => BusinessChatContent::MAX_ATTACHMENTS,
    "max-size" => BusinessChatContent::MAX_ATTACHMENT_SIZE,
    "allowed-extensions" => BusinessChatContent::ALLOWED_ATTACHMENT_TYPES.keys.join(",") } }
  .business-composer__bar
    .business-composer__toolbar{ role: "toolbar", "aria-label" => "文字の書式", "aria-controls" => input_id }
      %button.business-composer__tool{ type: "button", data: { format: "bold" }, title: "選んだ文字を太字にします" }
        %strong{ "aria-hidden" => "true" } B
        %span 太字
      %button.business-composer__tool{ type: "button", data: { format: "heading" }, title: "選んだ行を大きい文字（見出し）にします" }
        %span.business-composer__tool-icon{ "aria-hidden" => "true" } A
        %span 大きい文字
      %button.business-composer__tool{ type: "button", data: { format: "list" }, title: "選んだ行を箇条書きにします" }
        %span.business-composer__tool-icon{ "aria-hidden" => "true" } ・
        %span 箇条書き
      %button.business-composer__tool{ type: "button", data: { format: "link" }, title: "リンクを入れます" }
        %span.business-composer__tool-icon{ "aria-hidden" => "true" } 🔗
        %span リンク
    .business-composer__tabs{ role: "group", "aria-label" => "表示の切り替え" }
      %button.business-composer__tab.is-active{ type: "button", "aria-pressed" => "true", data: { "composer-tab" => "edit" } } 入力
      %button.business-composer__tab{ type: "button", "aria-pressed" => "false", data: { "composer-tab" => "preview" } } プレビュー
  .business-composer__edit
    = f.text_area :body, id: input_id, rows: 3, class: "business-composer__textarea",
        placeholder: local_assigns.fetch(:placeholder, "メッセージを入力..."), "aria-label" => "メッセージ"
  .business-composer__preview{ hidden: true, "aria-live" => "polite" }
    .markdown-body.business-chat-markdown.business-composer__preview-body
  .business-composer__footer
    .business-composer__attach
      %label.business-composer__attach-btn
        %span{ "aria-hidden" => "true" } 📎
        %span ファイルを添付
        = f.file_field :attachments, multiple: true, accept: BusinessChatContent.accept_attribute,
            class: "business-composer__file-input"
      %p.business-composer__limits= BusinessChatContent.limits_description
    = f.submit local_assigns.fetch(:submit_label, "送信"), class: "btn btn-primary business-composer__submit",
        data: { "disable-with" => "送信中..." }
  %ul.business-composer__file-list{ hidden: true, "aria-label" => "添付するファイル" }
  %p.business-composer__error{ role: "alert", hidden: true }
