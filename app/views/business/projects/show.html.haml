= render "layouts/header_menu_nakama"

.container.project-show

  / =========================
  / ヘッダー
  / =========================
  .project-hero

    - if @project.project_image.attached?
      = image_tag @project.project_image, class:"project-cover"

    .project-hero-overlay

      .project-hero-content

        %h1.project-title= @project.title

        .project-meta
          %span 👤 #{customer_display_name(@project.customer)}
          %span 🏢 #{@project.community.name}
          %span 🗓 #{l(@project.created_at, format: :short)}

        - deadline_over = @project.deadline.present? && @project.deadline < Time.current

        .project-actions

          - if @project.customer == current_customer
            = link_to "編集",
              edit_business_project_path(@project),
              class:"btn btn-primary"

          - if @project.members.include?(current_customer)
            %span.btn.btn-joined.btn-joined--light 参加中

          - elsif deadline_over
            %span.btn.btn-disabled 募集終了

          - elsif @project.community.customers.include?(current_customer)
            = link_to "参加",
              join_business_project_path(@project),
              method: :post,
              class:"btn btn-primary"

          - else
            = link_to "コミュニティに参加する",
              business_community_path(@project.community),
              class:"btn btn-primary"

            %p.join-note
              ※このプロジェクトに参加するには、
              %br
              開催コミュニティに事前に参加する必要があります。

        %span.status-badge= @project.status

        .project-goal
          %span.goal-label 🎯 GOAL
          %p.goal-text= @project.goal

        - if @project.deadline.present?
          %p ⏰ 締切：#{l(@project.deadline, format: :short)}
        - else
          %p ⏰ 締切：未設定

  / =========================
  / 本文
  / =========================
  .project-section
    %h3 概要
    .markdown-body= markdown(@project.description)

  / =========================
  / メンバー
  / =========================
  .project-section
    %h3 メンバー

    .member-grid
      - @project.active_members.each do |customer|
        = link_to business_customer_path(customer) do
          .member-card
            = customer_avatar_tag(customer, class_name: "member-icon")

            .member-info
              %span.member-name= customer.name

              - if customer == @project.customer
                %span.owner-tag オーナー

  / =========================
  / チャット
  / =========================
  .project-section
    %h3 チャット

    - if @project.members.include?(current_customer)

      .chat-container

        - if @messages.present?

          - @messages.each do |msg|
            - is_me = msg.customer == current_customer

            .chat-row

              .chat-avatar
                = customer_avatar_tag(msg.customer, class_name: "chat-avatar-img")

              .chat-content

                .chat-header
                  %span.chat-user= customer_display_name(msg.customer)

                  - if msg.customer == @project.customer && !customer_withdrawn?(msg.customer)
                    %span.owner-tag オーナー

                  %span.chat-time= l(msg.created_at, format: :short)

                .chat-bubble{ class: is_me ? "me" : "" }
                  .chat-body
                    = render "business/chat/message_content", record: msg

                - if is_me
                  = link_to "削除",
                    business_project_project_chat_path(@project, msg),
                    method: :delete,
                    data: { confirm: "削除する？" },
                    class: "chat-delete"

        - else
          .empty-state
            %p まだメッセージはありません
            %span 最初の一言を投稿してみよう！

      = render "business/chat/lightbox"

      / 投稿フォーム
      .business-chat-compose
        = form_with model: [ :business, @project, @new_message ], local: true, html: { class: "chat-form business-chat-form" } do |f|
          = render "business/chat/composer", f: f, placeholder: "メッセージを入力...", submit_label: "送信"
        = render "business/chat/stamp_picker", url: business_project_project_chats_path(@project), param_key: :project_chat

    - else

      .chat-locked
        %p 🔒 このチャットはプロジェクト参加者のみ閲覧できます
        = link_to "参加する",
          join_business_project_path(@project),
          method: :post,
          class:"btn btn-primary"
