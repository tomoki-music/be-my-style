= render "layouts/header_menu_nakama"

.container.project-show

  / =========================
  / ヘッダー
  / =========================
  .project-hero

    - if @project.project_image.attached?
      = image_tag @project.project_image, class:"project-cover"

    .project-hero-overlay

      .project-hero-content

        %h1.project-title= @project.title

        .project-meta
          %span 👤 #{customer_display_name(@project.customer) || ApplicationHelper::WITHDRAWN_CUSTOMER_LABEL}
          %span 🏢 #{@project.community.name}
          %span 🗓 #{l(@project.created_at, format: :short)}

        .project-actions

          - if @can_manage_project
            .project-actions__row
              = link_to "編集", edit_business_project_path(@project), class:"btn btn-primary"
              = link_to members_business_project_path(@project), class:"btn btn-light" do
                メンバー管理
                - if @pending_request_count.to_i.positive?
                  %span.membership-count-badge= @pending_request_count

          - if @can_view_internal
            %span.btn.btn-joined.btn-joined--light 参加中

          - else
            = render "business/projects/join_status"

        %p.project-join-mode
          参加方式：#{business_join_approval_label(@project)}

        %span.status-badge= @project.status

        .project-goal
          %span.goal-label 🎯 GOAL
          %p.goal-text= @project.goal

        - if @project.deadline.present?
          %p ⏰ 締切：#{l(@project.deadline, format: :short)}
        - else
          %p ⏰ 締切：未設定

  / =========================
  / 本文
  / =========================
  .project-section
    %h3 概要
    .markdown-body= markdown(@project.description)

  - if @can_view_internal

    / =========================
    / スレッド
    / =========================
    .project-section#threads
      = render "business/project_threads/repair_failed"
      .project-section__header
        %h3 スレッド
        = link_to "＋ 新しいスレッド", new_business_project_thread_path(@project), class: "btn btn-primary btn-small"

      = render "business/project_threads/list", project: @project, threads: @threads, post_counts: @thread_post_counts

      - if @thread_count > @threads.size
        .project-thread-more
          = link_to "すべてのスレッドを見る（#{@thread_count}件）", business_project_threads_path(@project), class: "btn btn-outline-primary"

    / =========================
    / メンバー
    / =========================
    .project-section
      %h3 メンバー

      .member-grid
        - @project.participating_members.each do |customer|
          = link_to business_customer_path(customer) do
            .member-card
              = customer_avatar_tag(customer, class_name: "member-icon")

              .member-info
                %span.member-name= customer.name

                - if customer == @project.customer
                  %span.owner-tag オーナー

      - if @project.project_members.exists?(customer_id: current_customer.id)
        .project-leave
          = link_to "プロジェクトから退出する", leave_business_project_path(@project),
            method: :delete, data: { confirm: "退出すると、スレッドを閲覧・投稿できなくなります。よろしいですか？" },
            class: "project-leave__link"

  - else

    .project-section
      .chat-locked
        %p 🔒 スレッドとメンバーはプロジェクト参加者のみ閲覧できます
