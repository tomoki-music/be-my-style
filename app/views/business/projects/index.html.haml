= render "layouts/header_menu_nakama"

-# 一覧は参加者向けの画面。作成は管理メニューの「プロジェクト管理」から行う。
- if @community.present?
  - can_manage_community = current_customer.can_manage_community?(@community)
  - can_create_project = current_customer.can_create_project_for?(@community)
  - if can_manage_community || can_create_project
    .manage-bar-wrap
      = render "shared/manage_bar", items: business_community_manage_items(@community, current: nil, manage: can_manage_community, projects: can_create_project)

.container.project-container

  .page-header
    %h2 プロジェクト一覧
    - if @community.present? && !current_customer.can_create_project_for?(@community) && @community.customers.include?(current_customer)
      = render "shared/feature_gate",
        feature_key: :business_project_create,
        title: "このコミュニティでプロジェクトを始める",
        class_name: "feature-gate--inline"

  .project-grid

    - @projects.each do |project|

      = link_to business_project_path(project), class:"project-link" do

        .project-card

          / =========================
          / 画像（←ここが主役）
          / =========================
          .card-image
            - if project.project_image.attached?
              = image_tag project.project_image, class:"project-img"
            - else
              .no-image
                %span No Image

          / =========================
          / 本文
          / =========================
          .card-body

            .project-header
              %h3.project-title= project.title

              .project-meta
                %span.community= project.community.name

            .project-body
              %p= truncate(project.description, length: 70)

            / =========================
            / フッター
            / =========================
            .project-footer

              .owner
                = customer_avatar_tag(project.customer, class_name: "mini-icon")

                %span= customer_display_name(project.customer) || ApplicationHelper::WITHDRAWN_CUSTOMER_LABEL

              .project-stats
                %span 👥 #{project.participating_members.count}
                %span 🗓 #{l(project.created_at, format: :short)}
