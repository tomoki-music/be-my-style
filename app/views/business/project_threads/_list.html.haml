-# スレッド一覧(新しく投稿があった順)。post_counts: { thread_id => 投稿数 }
- project = local_assigns.fetch(:project)
- threads = local_assigns.fetch(:threads)
- post_counts = local_assigns.fetch(:post_counts)
- if threads.empty?
  .ba-empty
    %p.ba-empty__title まだスレッドはありません
    %p 話題ごとにスレッドを作って会話を整理しましょう
- else
  %ul.ba-thread-list
    - threads.each do |thread|
      %li.ba-thread-list__item
        = link_to business_project_thread_path(project, thread), class: "ba-thread-list__link" do
          %span.ba-thread-list__icon{ "aria-hidden": "true" }
            %i.fa-regular.fa-comments
          %span.ba-thread-list__main
            %span.ba-thread-list__title= thread.title
            - if thread.description.present?
              %span.ba-thread-list__description= truncate(thread.description, length: 80)
            %span.ba-thread-list__meta
              %span.ba-thread-list__count
                %i.fa-regular.fa-comment{ "aria-hidden": "true" }
                投稿#{post_counts.fetch(thread.id, 0)}件
              %span
                最終更新：
                %time{ datetime: thread.last_posted_at.iso8601 }= l(thread.last_posted_at, format: :short)
              %span 作成：#{customer_display_name(thread.customer) || ApplicationHelper::WITHDRAWN_CUSTOMER_LABEL}
          %i.fa-solid.fa-chevron-right.ba-thread-list__chevron{ "aria-hidden": "true" }
