- thread = local_assigns.fetch(:thread)
= form_with model: thread, url: (thread.persisted? ? business_project_thread_path(@project, thread) : business_project_threads_path(@project)), local: true, html: { class: "ba-form" } do |f|
  - if thread.errors.any?
    .ba-errors{ role: "alert" }
      %ul
        - thread.errors.full_messages.each do |message|
          %li= message
  .ba-fieldset
    .ba-field
      = f.label :title, "タイトル", class: "ba-label"
      = f.text_field :title, class: "form-control", maxlength: ProjectThread::TITLE_MAX_LENGTH, required: true, placeholder: "例）デザイン相談"
    .ba-field
      = f.label :description, class: "ba-label" do
        説明
        %span.ba-optional 任意
      = f.text_area :description, class: "form-control", rows: 4, maxlength: ProjectThread::DESCRIPTION_MAX_LENGTH, placeholder: "このスレッドで話すこと"
  .ba-form-actions
    = f.submit (thread.persisted? ? "更新する" : "作成する"), class: "ba-btn ba-btn--primary"
    = link_to "戻る", (thread.persisted? ? business_project_thread_path(@project, thread) : business_project_path(@project, anchor: "threads")), class: "ba-btn ba-btn--secondary"
