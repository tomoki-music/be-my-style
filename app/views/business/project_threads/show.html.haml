= render "business/project_threads/breadcrumb", current: @thread.title, thread: @thread
= render "business/project_threads/repair_failed"

%header.ba-thread-header
  .ba-thread-header__text
    %h1.ba-page-title= @thread.title
    - if @thread.description.present?
      .ba-thread-header__description= simple_format(@thread.description)
    %p.ba-thread-header__meta
      作成：#{customer_display_name(@thread.customer) || ApplicationHelper::WITHDRAWN_CUSTOMER_LABEL}
      %span{ "aria-hidden": "true" } ・
      最終更新：#{l(@thread.last_posted_at, format: :short)}
  -# 編集・削除の可否はスレッドごとの権限(全体トークは削除不可)に従う。
  - if current_customer.can_edit_project_thread?(@thread) || current_customer.can_destroy_project_thread?(@thread)
    .ba-thread-header__actions
      - if current_customer.can_edit_project_thread?(@thread)
        = link_to edit_business_project_thread_path(@project, @thread), class: "ba-btn ba-btn--secondary ba-btn--sm" do
          %i.fa-solid.fa-pen{ "aria-hidden": "true" }
          編集
      - if current_customer.can_destroy_project_thread?(@thread)
        = link_to business_project_thread_path(@project, @thread),
          method: :delete, data: { confirm: "スレッドと、その中の投稿をすべて削除します。よろしいですか？" },
          class: "ba-btn ba-btn--danger ba-btn--sm" do
          %i.fa-regular.fa-trash-can{ "aria-hidden": "true" }
          削除

%section.ba-card.ba-conversation{ "aria-label": "メッセージ" }
  - if @messages.present?
    %ol.ba-feed
      - @messages.each do |msg|
        %li
          = render "business/chat/post", record: msg, owner: @project.customer,
            delete_path: (msg.customer == current_customer ? business_project_thread_project_chat_path(@project, @thread, msg) : nil)
  - else
    .ba-empty
      %p.ba-empty__title まだメッセージはありません
      %p 最初の一言を投稿してみよう！

  = render "business/chat/lightbox"

  .business-chat-compose.ba-conversation__compose
    = form_with model: @new_message, url: business_project_thread_project_chats_path(@project, @thread), local: true, html: { class: "chat-form business-chat-form" } do |f|
      = render "business/chat/composer", f: f, placeholder: "メッセージを入力...", submit_label: "送信"
    = render "business/chat/stamp_picker", url: business_project_thread_project_chats_path(@project, @thread), param_key: :project_chat
