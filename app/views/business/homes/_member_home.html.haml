-# Business のログイン後ホーム本文。本文は「コミュニティ」「プロジェクト」の2一覧が主役。
-# コミュニティは Business::CommunityDirectory.browsable(参加済み・未参加を問わず Business コミュニティ全件)で、
-# 未参加のものは詳細(参加案内)から参加・参加申請へ進む。参加済みだけの一覧はメニューの「コミュニティ」。
-# プロジェクトは Homes::MyProjects(本人の参加先)。承認待ちは名前と状態以外を出さない。
-# 紹介ヒーロー・キャッチコピー・料金表は置かず、末尾に小さな利用ガイド(使い方への導線)だけを置く。
-# 音楽コミュニティは(両方の利用者でも)出さない。
- communities = @home_communities.communities
- projects = @my_projects.projects
- project_search_available = member_home_project_search_available?

.ba-home
  %h1.sr-only ホーム

  %section.ba-home__section.ba-anchor-target#my-communities{ "aria-labelledby": "my-communities-title" }
    .ba-section-header
      %h2.ba-section-title#my-communities-title
        コミュニティ
        - if communities.total_count.positive?
          %span.ba-count= "#{communities.total_count}件"
      = link_to business_communities_path, class: "ba-btn ba-btn--secondary ba-btn--sm" do
        %i.fa-solid.fa-user-group{ "aria-hidden": "true" }
        参加中のコミュニティ

    - if communities.total_count.zero?
      .ba-empty.ba-empty--guide
        .ba-empty-guide__media
          = business_illustration(:ribbon_small, loading: "eager")
        .ba-empty-guide__body
          %p.ba-empty__title コミュニティはまだありません
          %p コミュニティができると、ここから選んで参加・参加申請できます。
          .ba-empty__actions
            = link_to "使い方を見る", business_help_path, class: "ba-btn ba-btn--secondary"
    - elsif communities.empty?
      .ba-empty
        %p このページに表示するコミュニティはありません。
        = link_to "最初のページへ", url_for(request.query_parameters.merge(community_page: nil, anchor: "my-communities")), class: "ba-btn ba-btn--secondary"
    - else
      %ul.ba-circle-grid
        - communities.each do |community|
          - status = @home_communities.statuses.fetch(community.id)
          %li.ba-circle-item{ class: "ba-circle-item--#{status}" }
            = link_to business_community_path(community), class: "ba-circle-item__link" do
              %span.ba-circle-item__media{ class: ("is-pending" if status == :pending) }
                = business_community_avatar(community, size: :lg)
              %span.ba-circle-item__name= community.name
            .ba-circle-item__badges
              - if status == :none
                %span.ba-status.ba-status--kind= business_join_approval_label(community)
              - else
                = business_join_status_badge(status)
      = paginate communities, param_name: :community_page, params: { anchor: "my-communities" }

  %section.ba-home__section.ba-anchor-target#my-projects{ "aria-labelledby": "my-projects-title" }
    .ba-section-header
      %h2.ba-section-title#my-projects-title
        プロジェクト
        - if projects.total_count.positive?
          %span.ba-count= "#{projects.total_count}件"
      - if projects.total_count.positive? && project_search_available
        = link_to "プロジェクトを探す", business_projects_path, class: "ba-text-link"

    - if projects.total_count.zero?
      .ba-empty
        -# プロジェクト一覧(/business/projects)は参加中コミュニティの分しか出ないため、前提のコミュニティ参加への導線も並べる。
        - if project_search_available
          %p 参加しているプロジェクトはまだありません。Business コミュニティに参加すると、そのコミュニティのプロジェクトへ参加を申請できます。
          .ba-empty__actions
            = link_to "プロジェクトを探す", business_projects_path, class: "ba-btn ba-btn--secondary"
            = link_to "コミュニティを探す", business_root_path(anchor: "my-communities"), class: "ba-btn ba-btn--primary"
        - else
          %p プロジェクトは Business（NAKAMA）のコミュニティで利用できる機能です。
          .ba-empty__actions
            = link_to "NAKAMAの利用を始める", business_join_path, class: "ba-btn ba-btn--primary"
    - elsif projects.empty?
      .ba-empty
        %p このページに表示するプロジェクトはありません。
        = link_to "最初のページへ", url_for(request.query_parameters.merge(project_page: nil, anchor: "my-projects")), class: "ba-btn ba-btn--secondary"
    - else
      %ul.ba-project-grid
        - projects.each do |project|
          - status = @my_projects.statuses.fetch(project.id)
          %li
            = render "business/projects/card", project: project,
              status_key: status, status_label: member_home_project_status_label(status),
              note: (status == :pending ? "承認されるとスレッドや投稿を見られます。" : nil)
      = paginate projects, param_name: :project_page, params: { anchor: "my-projects" }

  - if communities.total_count.positive?
    %aside.ba-home-guide{ "aria-labelledby": "home-guide-title" }
      .ba-home-guide__media
        = business_illustration(:ribbon_small)
      .ba-home-guide__body
        %h2.ba-home-guide__title#home-guide-title 利用ガイド
        %ol.ba-home-guide__steps
          %li コミュニティに参加
          %li プロジェクトに参加
          %li スレッドで話す
        %p.ba-home-guide__links
          = link_to business_help_path, class: "ba-text-link" do
            使い方を見る
            %i.fa-solid.fa-arrow-right{ "aria-hidden": "true" }
          = link_to business_help_audience_path("admin"), class: "ba-text-link" do
            管理者向けの使い方
            %i.fa-solid.fa-arrow-right{ "aria-hidden": "true" }
