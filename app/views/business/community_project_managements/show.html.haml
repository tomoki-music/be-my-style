= render "shared/manage_bar", items: business_community_manage_items(@community, current: :projects, pending_count: @pending_permit_count, manage: @can_manage_community)

%nav.ba-breadcrumb{ "aria-label": "現在地" }
  %ol
    %li= link_to @community.name, business_community_path(@community)
    %li
      %span{ "aria-current": "page" } プロジェクト管理

.ba-page-header
  .ba-page-header__text
    %h1.ba-page-title プロジェクト管理
    %p.ba-page-lead 「#{@community.name}」の中にプロジェクトを作成します。参加できるのは、このコミュニティの参加者です。
  .ba-page-actions
    = link_to new_business_project_path(community_id: @community.id), class: "ba-btn ba-btn--primary" do
      %i.fa-solid.fa-plus{ "aria-hidden": "true" }
      新しいプロジェクトを作成

%section.ba-card#projects{ "aria-labelledby": "managed-projects-title" }
  %h2.ba-section-title#managed-projects-title
    このコミュニティのプロジェクト
    %span.ba-count （#{@projects.size}件）
  - if @projects.empty?
    %p.ba-muted.ba-section-body まだプロジェクトはありません。
  - else
    %ul.ba-rows
      - @projects.each do |project|
        %li.ba-row
          .ba-row__main
            = link_to project.title, business_project_path(project), class: "ba-row__title"
            %span.ba-person__meta.d-block
              作成：#{customer_display_name(project.customer) || ApplicationHelper::WITHDRAWN_CUSTOMER_LABEL}
              ／ 更新：#{l(project.updated_at, format: :short)}
          .ba-row__actions.project-management__actions
            = link_to "通常画面", business_project_path(project), class: "ba-btn ba-btn--secondary ba-btn--sm"
            - if @manageable_project_ids.include?(project.id)
              = link_to "編集", edit_business_project_path(project), class: "ba-btn ba-btn--soft ba-btn--sm"
              = link_to "メンバー管理", members_business_project_path(project), class: "ba-btn ba-btn--soft ba-btn--sm"
