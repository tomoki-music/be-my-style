= render "layouts/header_menu_nakama"

.container.membership-admin
  %nav.project-breadcrumb{ "aria-label" => "現在地" }
    = link_to @community.name, business_community_path(@community)
    %span{ "aria-hidden" => "true" } ›
    %span メンバー管理

  %h2.membership-admin__title メンバー管理

  %section.membership-admin__card
    %h3 参加方式
    %p.membership-admin__mode
      %strong= business_join_approval_label(@community)
      %span= business_join_approval_description(@community)
    %p.membership-admin__note 変更は、変更後の新しい参加申請から適用されます。承認待ちの申請と参加済みのメンバーはそのままです。
    = link_to "参加方式を変更する", edit_business_community_path(@community), class: "btn btn-light btn-small"

  %section.membership-admin__card#join-requests
    %h3 参加申請（#{@permits.size}件）
    - if @permits.empty?
      %p.membership-admin__empty 現在、参加申請はありません。
    - else
      %ul.membership-admin__list
        - @permits.each do |permit|
          %li.membership-admin__row.permit-card
            .membership-admin__person
              = customer_avatar_tag(permit.customer, class_name: "membership-admin__avatar")
              %strong.membership-admin__name= permit.customer.name
              %span.membership-admin__date 申請：#{l(permit.created_at, format: :short)}
            .membership-admin__actions
              = link_to "承認",
                business_community_community_customers_path(community_id: @community.id, customer_id: permit.customer.id, return_to: "permits"),
                method: :post,
                class:"btn btn-success btn-small"
              = link_to "却下",
                business_community_permit_path(@community, customer_id: permit.customer.id, return_to: "permits"),
                method: :delete, data: { confirm: "#{permit.customer.name}さんの申請を却下しますか？（再申請はできます）" },
                class:"btn btn-outline-danger btn-small"

  %section.membership-admin__card#members
    %h3 参加者（#{@members.size}人）
    %p.membership-admin__note アクセスを停止すると、配下のプロジェクトの参加資格も外れます。
    %ul.membership-admin__list
      - @members.each do |member|
        %li.membership-admin__row
          .membership-admin__person
            = customer_avatar_tag(member, class_name: "membership-admin__avatar")
            %span.membership-admin__name= member.name
          .membership-admin__actions
            - if @manager_ids.include?(member.id) || member.admin?
              %span.membership-admin__tag 運営者
            - else
              = link_to "アクセス停止", business_community_access_suspensions_path(@community, customer_id: member.id),
                method: :post, data: { confirm: "#{member.name}さんをコミュニティと配下のプロジェクトから外し、アクセスを停止しますか？（解除するまで再参加できません）" },
                class: "btn btn-outline-danger btn-small"

  %section.membership-admin__card#suspensions
    %h3 アクセス停止中（#{@suspensions.size}人）
    - if @suspensions.empty?
      %p.membership-admin__empty アクセス停止中のユーザーはいません。
    - else
      %ul.membership-admin__list
        - @suspensions.each do |suspension|
          %li.membership-admin__row
            .membership-admin__person
              = customer_avatar_tag(suspension.customer, class_name: "membership-admin__avatar")
              %span.membership-admin__name= customer_display_name(suspension.customer)
              %span.membership-admin__date 停止：#{l(suspension.created_at, format: :short)}
            .membership-admin__actions
              = link_to "停止を解除", business_community_access_suspension_path(@community, suspension),
                method: :delete, data: { confirm: "停止を解除しますか？（参加するには、本人の再度の参加・申請が必要です）" },
                class: "btn btn-light btn-small"
