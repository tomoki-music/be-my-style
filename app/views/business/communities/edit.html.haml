= render "shared/manage_bar", items: business_community_manage_items(@community, current: :edit, pending_count: @pending_permit_count)

%nav.ba-breadcrumb{ "aria-label": "現在地" }
  %ol
    %li= link_to @community.name_was.presence || @community.name, business_community_path(@community)
    %li
      %span{ "aria-current": "page" } 編集

.ba-page-header
  .ba-page-header__text
    %h1.ba-page-title コミュニティ編集

= render "form", community: @community, cancel_path: business_community_path(@community)

-# プロジェクトの作成は通常画面ではなく管理側から行う(運営者は必ず作成できる)。
%section.ba-fieldset.ba-form#project-management{ "aria-labelledby": "community-edit-projects-title" }
  %h2.ba-fieldset__legend#community-edit-projects-title プロジェクト管理
  %p.ba-note このコミュニティでプロジェクトを立ち上げます。作成したプロジェクトは通常画面の「プロジェクト」に表示されます。
  .ba-form-actions
    = link_to "新しいプロジェクトを作成", new_business_project_path(community_id: @community.id), class: "ba-btn ba-btn--soft"
    = link_to "プロジェクト管理を開く", business_community_project_management_path(@community), class: "ba-btn ba-btn--secondary"

-# お試し設定は通常の更新とは別の窓口(システム管理者のみ変更可)なので、フォームを分けて置く。
= render "plan_trial", community: @community

-# 削除は取り消せないため、編集フォームとは別の枠に置く。表示条件は削除処理(ensure_community_owner!)と同じ。
- if current_customer.can_destroy_community?(@community)
  %section.ba-fieldset.ba-form.ba-danger-zone#community-delete{ "aria-labelledby": "community-delete-title" }
    %h2.ba-fieldset__legend#community-delete-title コミュニティの削除
    %p.ba-note コミュニティと、その中のプロジェクト・投稿をまとめて削除します。削除すると元に戻せません。次の画面で削除される内容を確認できます。
    .ba-form-actions
      = link_to "コミュニティを削除", destroy_confirmation_business_community_path(@community), class: "ba-btn ba-btn--danger"
