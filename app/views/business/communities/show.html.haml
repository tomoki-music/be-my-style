-# 運営者にも参加者と同じ画面を出す。設定フォーム・承認・停止は編集 / メンバー管理画面に置き、ここには移動の導線だけを出す。
-# 運営者でなくても、プロジェクトを作成できる参加者には「プロジェクト管理」だけを出す。
- if @can_manage || @can_create_project
  = render "shared/manage_bar", items: business_community_manage_items(@community, current: :show, pending_count: @pending_permit_count, manage: @can_manage, projects: @can_create_project)
- elsif plan_trial_editable?
  -# システム管理者(Admin セッション)で運営者ではない場合、お試し設定は管理画面のコミュニティ詳細で変更する。
  = render "shared/manage_bar", items: [{ label: "お試し設定（管理画面）", path: admin_community_path(@community), data: { turbolinks: false } }]

%article.ba-profile
  .ba-profile__cover{ class: ("ba-profile__cover--empty" unless @community.community_image.attached?) }
    - if @community.community_image.attached?
      = image_tag @community.community_image, class: "ba-profile__cover-image", alt: ""
  .ba-profile__head
    .ba-profile__avatar
      = business_community_avatar(@community, size: :xl)
    .ba-profile__title-block
      %h1.ba-profile__name= @community.name
      %ul.ba-profile__meta
        %li
          %i.fa-solid.fa-user-group{ "aria-hidden": "true" }
          = "#{@community.active_customers.count}人"
        %li
          %i.fa-solid.fa-door-open{ "aria-hidden": "true" }
          参加方式：#{business_join_approval_label(@community)}

  .ba-profile__body
    .ba-profile__owner
      - if customer_withdrawn?(@community.owner)
        .ba-person
          .ba-person__avatar= customer_avatar_tag(@community.owner, class_name: "ba-person__img")
          .ba-person__text
            %span.ba-person__meta オーナー
            %span.ba-person__name= customer_display_name(@community.owner)
      - else
        = link_to business_customer_path(@community.owner), class: "ba-person ba-person--link" do
          .ba-person__avatar= customer_avatar_tag(@community.owner, class_name: "ba-person__img")
          .ba-person__text
            %span.ba-person__meta オーナー
            %span.ba-person__name= @community.owner.name

    - if @community.plan_restrictions_waived?
      %p.ba-trial-badge
        %i.fa-solid.fa-gift{ "aria-hidden": "true" }
        無料お試し中：このコミュニティ内では有料プランの機能制限が解除されています

    = render "business/communities/join_panel"
    = render "business/shared/share_link", record: @community

- if @can_view_internal
  %nav.ba-sectnav{ "aria-label": "このコミュニティの内容" }
    %ul
      %li= link_to "概要", "#about"
      %li= link_to "プロジェクト", "#projects"
      %li= link_to "コミュニティ内の会話", "#timeline"
      %li= link_to "メンバー", "#members"

.ba-columns
  .ba-columns__main
    %section.ba-card.ba-anchor-target#about{ "aria-labelledby": "community-about-title" }
      %h2.ba-section-title#community-about-title 概要
      .ba-section-body
        .markdown-body= markdown(@community.introduction)

    - if @can_view_internal
      -# 件数・空判定のたびに問い合わせないよう、先に読み込んでおく。
      - projects = @projects.to_a
      - timeline_posts = @timeline_posts.to_a
      %section.ba-card.ba-anchor-target#projects{ "aria-labelledby": "community-projects-title" }
        .ba-section-header
          %h2.ba-section-title#community-projects-title
            プロジェクト
            %span.ba-count= "#{projects.size}件"

        -# 作成は管理メニューの「プロジェクト管理」から行う。作成できない参加者には、必要なプランの案内だけを文字で出す。
        - if !@can_create_project && @community.customers.include?(current_customer)
          %p.ba-note.ba-project-create-note
            = feature_gate(:business_project_create)[:message]
            = link_to feature_upgrade_cta(:business_project_create), feature_upgrade_path(:business_project_create)

        - if projects.empty?
          %p.ba-muted まだプロジェクトはありません。
        - else
          %ul.ba-project-grid
            - projects.each do |project|
              %li= render "business/projects/card", project: project, show_community: false, description: project.description,
                join_status: @project_statuses.fetch(project.id)

      %section.ba-card.ba-anchor-target#timeline{ "aria-labelledby": "community-timeline-title" }
        -# 全体向けのタイムライン(ビジネス投稿)と区別するため「コミュニティ内の会話」と呼ぶ。アンカー(#timeline)は従来のまま。
        %h2.ba-section-title#community-timeline-title コミュニティ内の会話
        %p.ba-note
          %i.fa-solid.fa-lock{ "aria-hidden": "true" }
          このコミュニティの参加者だけが見られます。タイムラインには表示されません。

        -# 閲覧・投稿とも参加者(メンバー / 管理権限 / 管理者)だけ。
        - if feature_available?(:business_community_post_create, community: @community)
          .business-chat-compose
            = form_with model: [:business, @community, CommunityPost.new], local: true, html: { class: "business-chat-form" } do |f|
              = render "business/chat/composer", f: f, placeholder: "投稿する...", submit_label: "投稿"
            = render "business/chat/stamp_picker", url: business_community_community_posts_path(@community), param_key: :community_post

        - if timeline_posts.empty?
          %p.ba-muted まだ投稿はありません。
        - else
          %ol.ba-feed
            - timeline_posts.each do |post|
              %li= render "business/chat/post", record: post, owner: @community.owner

        = render "business/chat/lightbox"

    - else
      %section.ba-card.ba-locked
        %h2.ba-section-title
          %i.fa-solid.fa-lock{ "aria-hidden": "true" }
          参加者限定
        %p.ba-muted プロジェクト・コミュニティ内の会話・メンバーは、コミュニティの参加者のみ閲覧できます。
        - if @join_status == :none
          %p.ba-muted 上の「#{business_join_button_label(@community)}」から参加すると、このコミュニティのプロジェクトを探して参加できます。

  - if @can_view_internal
    %aside.ba-columns__side
      %section.ba-card.ba-anchor-target#members{ "aria-labelledby": "community-members-title" }
        - members = @community.active_customers.to_a
        %h2.ba-section-title#community-members-title
          メンバー
          %span.ba-count= "#{members.size}人"
        %ul.ba-member-list
          - members.each do |customer|
            %li
              = link_to business_customer_path(customer), class: "ba-person ba-person--link" do
                .ba-person__avatar= customer_avatar_tag(customer, class_name: "ba-person__img")
                .ba-person__text
                  %span.ba-person__name= customer.name
                  - if customer == @community.owner
                    %span.ba-person__meta オーナー
        - if @join_status == :member
          .ba-leave
            = link_to "コミュニティから退出する", business_community_community_customers_path(@community),
              method: :delete, data: { confirm: "退出すると、このコミュニティとプロジェクトの内容を閲覧・投稿できなくなります。よろしいですか？" },
              class: "ba-btn ba-btn--danger ba-btn--sm"
