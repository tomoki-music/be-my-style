= render "layouts/header_menu_nakama"

.community-container

  / =========================
  / ヒーロー
  / =========================
  .community-hero

    - if @community.community_image.attached?
      = image_tag @community.community_image, class:"community-cover"

    .hero-overlay

      .hero-content

        %h1= @community.name

        .hero-meta
          👥 #{@community.active_customers.count}人

        - if @community.plan_restrictions_waived?
          %p.plan-trial-badge 🎁 無料お試し中：このコミュニティ内では有料プランの機能制限が解除されています

        / ===== オーナー =====
        .hero-owner
          - if customer_withdrawn?(@community.owner)
            .owner-info
              .owner-avatar
                = customer_avatar_tag(@community.owner, class_name: "owner-img")
              .owner-meta
                %span.owner-label オーナー
                %span.owner-name
                  = customer_display_name(@community.owner)
          - else
            = link_to business_customer_path(@community.owner) do
              .owner-info

                .owner-avatar
                  = customer_avatar_tag(@community.owner, class_name: "owner-img")

                .owner-meta
                  %span.owner-label オーナー
                  %span.owner-name
                    = @community.owner.name
                    %span.owner-badge 👑

        / ===== アクション =====
        .hero-actions

          - if current_customer.can_manage_community?(@community)

            = link_to "✏️ 編集",
              edit_business_community_path(@community),
              class: "btn btn-primary btn-small"

          - if @community.customers.include?(current_customer)

            %span.btn-joined 参加済み

          - elsif @permit.present?

            .permit-status
              %span.permit-badge 🟡 申請中

              = link_to "申請を取り消す",
                business_community_permit_path(@community, customer_id: current_customer.id),
                method: :delete,
                class:"permit-cancel"

          - else

            .permit-cta

              = link_to "参加申請する",
                business_community_permit_path(@community),
                method: :post,
                class:"btn btn-primary btn-cta"

              %p.permit-note
                このコミュニティに参加すると、
                %br
                プロジェクトや限定コンテンツに参加できます。

  / =========================
  / メイン
  / =========================
  .community-body

    / ===== 左 =====
    .left

      .card
        %h3 概要
        .introduction
          .markdown-body= markdown(@community.introduction)

      .card
        .section-header
          %h3 プロジェクト

          - if current_customer.can_create_project_for?(@community)
            = link_to "＋ 作成",
              new_business_project_path(community_id: @community.id),
              class:"btn btn-primary btn-small"
          - elsif @community.customers.include?(current_customer)
            = link_to feature_upgrade_cta(:business_project_create),
              feature_upgrade_path(:business_project_create),
              class:"btn btn-primary btn-small menu-btn-locked"

        .project-grid
          - @projects.each do |project|
            = link_to business_project_path(project) do
              .project-card
                %h4= project.title
                %p= truncate(project.description.to_s, length: 80)

      .card#timeline
        %h3 タイムライン

        -# 閲覧(本文・添付)はログイン中の会員なら可能。投稿は参加者(メンバー / 管理権限 / 管理者)だけ。
        - if @can_post_timeline
          - if feature_available?(:business_community_post_create, community: @community)
            .business-chat-compose
              = form_with model: [:business, @community, CommunityPost.new], local: true, html: { class: "business-chat-form" } do |f|
                = render "business/chat/composer", f: f, placeholder: "投稿する...", submit_label: "投稿"
              = render "business/chat/stamp_picker", url: business_community_community_posts_path(@community), param_key: :community_post
        - else
          %p.timeline-join-note
            タイムラインへの投稿はコミュニティ参加者のみできます。
            %br
            コミュニティに参加すると、freeプランのまま投稿できます。

        - @timeline_posts.each do |post|

          .timeline-item

            .timeline-header

              .user-block

                .avatar
                  = customer_avatar_tag(post.customer, class_name: "avatar-img")

                .user-info
                  %span.user-name
                    = customer_display_name(post.customer)

                    - if post.customer == @community.owner && !customer_withdrawn?(post.customer)
                      %span.owner-tag オーナー

                  %span.time= time_ago_in_words(post.created_at) + "前"

            .timeline-body
              = render "business/chat/message_content", record: post

        = render "business/chat/lightbox"

    / ===== 右 =====
    .right

      .card
        %h3 メンバー

        .member-grid
          - @community.active_customers.each do |customer|
            = link_to business_customer_path(customer) do
              .member-card
                = customer_avatar_tag(customer, class_name: "member-icon")

                .member-info
                  %span.member-name= customer.name

                  - if customer == @community.owner
                    %span.owner-tag オーナー

      -# 変更できるのはシステム管理者だけ。コミュニティの運営者には状態のみ表示する。
      - if plan_trial_editable? || current_customer.can_manage_community?(@community)
        .card.plan-trial-card#plan-trial
          %h3= plan_trial_label
          %p.plan-trial-card__status{ class: ("is-on" if @community.plan_restrictions_waived?) }
            現在：#{plan_trial_status_label(@community)}
          %p.plan-trial-card__note= plan_trial_description
          %p.plan-trial-card__features-title 無料で利用できるようになる機能
          %ul.plan-trial-card__features
            - plan_trial_unlocked_features.each do |feature|
              %li= feature
          - if plan_trial_editable?
            = form_with model: @community, url: business_community_plan_trial_path(@community), method: :patch, local: true do |f|
              %label.plan-trial-card__toggle
                = f.check_box :plan_restrictions_waived
                %span= plan_trial_label
              = f.submit "保存する", class: "btn btn-primary btn-small"
          - else
            %p.plan-trial-card__readonly= plan_trial_readonly_note

      - if @can_review_permits
        .card
          %h3 参加申請

          - if @permits.empty?
            %p.permit-empty 現在、参加申請はありません。

          - @permits.each do |permit|
            .permit-card
              %span= permit.customer.name

              .permit-actions
                = link_to "承認",
                  business_community_community_customers_path(community_id: @community.id, customer_id: permit.customer.id),
                  method: :post,
                  class:"btn btn-success btn-small"

                = link_to "拒否",
                  business_community_permit_path(@community, customer_id: permit.customer.id),
                  method: :delete,
                  class:"btn btn-danger btn-small"
