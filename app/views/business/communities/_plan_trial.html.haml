-# 変更できるのはシステム管理者(Admin セッション)だけ。コミュニティの運営者には状態のみ表示する。
%section.ba-fieldset.ba-form.plan-trial-card#plan-trial{ "aria-labelledby": "plan-trial-title" }
  %h2.ba-fieldset__legend#plan-trial-title= plan_trial_label
  %p.plan-trial-card__status{ class: ("is-on" if community.plan_restrictions_waived?) }
    現在：#{plan_trial_status_label(community)}
  %p.ba-note= plan_trial_description
  %p.ba-label 無料で利用できるようになる機能
  %ul.plan-trial-card__features
    - plan_trial_unlocked_features.each do |feature|
      %li= feature
  - if plan_trial_editable?
    = form_with model: community, url: business_community_plan_trial_path(community), method: :patch, local: true do |f|
      %label.ba-check
        = f.check_box :plan_restrictions_waived
        %span= plan_trial_label
      .ba-form-actions
        = f.submit "保存する", class: "ba-btn ba-btn--primary ba-btn--sm"
  - else
    %p.ba-note= plan_trial_readonly_note
