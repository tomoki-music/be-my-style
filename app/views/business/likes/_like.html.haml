%div{id: "like_button_#{post.id}"}

  - if current_customer.likes.exists?(post: post)

    = link_to business_post_like_path(post),
      method: :delete,
      remote: true,
      class: "like-btn liked",
      "aria-label": "いいねを取り消す（#{post.likes.count}件）" do

      %i.fa-solid.fa-heart
      = post.likes.count

  - else

    = link_to business_post_like_path(post),
      method: :post,
      remote: true,
      class: "like-btn",
      "aria-label": "いいねする（#{post.likes.count}件）" do

      %i.fa-regular.fa-heart
      = post.likes.count