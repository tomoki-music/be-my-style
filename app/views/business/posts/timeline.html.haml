- current_tab = params[:tab].presence || "recommended"

.ba-page-header
  .ba-page-header__text
    %h1.ba-page-title タイムライン
    %p.ba-page-lead フォローしている人の「いま起きていること」をチェックしよう
  .ba-page-actions
    - if feature_available?(:business_post_create)
      = link_to new_business_post_path, class: "ba-btn ba-btn--primary" do
        %i.fa-solid.fa-plus{ "aria-hidden": "true" }
        投稿する
    - else
      = link_to feature_upgrade_cta(:business_post_create), feature_upgrade_path(:business_post_create), class: "ba-btn ba-btn--soft"

= form_with url: business_timeline_path, method: :get, local: true, class: "ba-search", role: "search" do |f|
  = hidden_field_tag :tab, params[:tab]
  .ba-search__field
    %i.fa-solid.fa-magnifying-glass.ba-search__icon{ "aria-hidden": "true" }
    = f.text_field :keyword, value: params[:keyword], placeholder: "投稿を検索", class: "form-control", "aria-label": "投稿を検索"
  = f.submit "検索", class: "ba-btn ba-btn--primary"
  = link_to "クリア", business_timeline_path(tab: params[:tab]), class: "ba-btn ba-btn--secondary"

%nav.ba-tabs{ "aria-label": "表示する投稿" }
  - { "recommended" => "おすすめ", "following" => "フォロー", "community" => "コミュニティ" }.each do |tab, label|
    = link_to label, business_timeline_path(tab: tab), "aria-current": (current_tab == tab ? "page" : nil)

- if @posts.present?
  %ul.ba-project-grid
    - @posts.each do |post|
      %li= render "business/posts/card", post: post
  = paginate @posts
- else
  .ba-empty
    %p.ba-empty__title 投稿がまだありません
    - if feature_available?(:business_post_create)
      %p 最初の投稿でコミュニティを盛り上げよう
      = link_to "投稿する", new_business_post_path, class: "ba-btn ba-btn--primary"
    - else
      = render "shared/feature_gate",
        feature_key: :business_post_create,
        title: "投稿を始める",
        class_name: "feature-gate--inline"
