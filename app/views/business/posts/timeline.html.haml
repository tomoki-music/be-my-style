-# ビジネス投稿(Post)の唯一の一覧。旧「投稿」一覧(/business/posts)は絞り込み条件ごとここへ転送している。
-# 投稿はログインした全員が見られる。参加者限定のコミュニティ内の会話・プロジェクトのスレッドは含まない。
-# 狭い幅でも語の途中で折れないよう、改行してよい位置だけ <wbr> で示す(help.scss の .ba-timeline__tabs)。
- tabs = { "recommended" => "おすすめ", "following" => "フォロー中", "community" => safe_join(["コミュニティの", tag.wbr, "仲間"]) }
- tab_notes = { "recommended" => "すべてのビジネス投稿を、反応の多さと新しさの順に表示しています。",
  "following" => "あなたとフォローしている人の投稿です。",
  "community" => "同じコミュニティに参加している人の投稿です。" }
- filters = @filters

.ba-page-header
  .ba-page-header__text
    %h1.ba-page-title タイムライン
    %p.ba-page-lead 活動の記録や知見を共有するビジネス投稿です。
  .ba-page-actions
    - if feature_available?(:business_post_create)
      = link_to new_business_post_path, class: "ba-btn ba-btn--primary" do
        %i.fa-solid.fa-plus{ "aria-hidden": "true" }
        投稿する
    - else
      = link_to feature_upgrade_cta(:business_post_create), feature_upgrade_path(:business_post_create), class: "ba-btn ba-btn--soft"

= render "business/posts/visibility_note"

= form_with url: business_timeline_path, method: :get, local: true, class: "ba-search", role: "search" do |f|
  = hidden_field_tag :tab, @tab, id: nil
  - if filters[:tag]
    = hidden_field_tag :tag, filters[:tag], id: nil
  - if filters[:user_id]
    = hidden_field_tag :user_id, filters[:user_id], id: nil
  .ba-search__field
    %i.fa-solid.fa-magnifying-glass.ba-search__icon{ "aria-hidden": "true" }
    = f.text_field :keyword, value: filters[:keyword], placeholder: "投稿を検索", class: "form-control", "aria-label": "投稿を検索"
  = f.submit "検索", class: "ba-btn ba-btn--primary"
  = link_to "クリア", business_timeline_path(tab: @tab), class: "ba-btn ba-btn--secondary"

%nav.ba-tabs.ba-timeline__tabs{ "aria-label": "表示する投稿" }
  - tabs.each do |tab, label|
    = link_to label, business_timeline_path(filters.merge(tab: tab).compact), "aria-current": (@tab == tab ? "page" : nil)
%p.ba-note.ba-timeline__tab-note= tab_notes.fetch(@tab)

- if filters[:user_id] || filters[:tag]
  %ul.ba-chip-list.ba-timeline__filters{ "aria-label": "絞り込み中の条件" }
    - if filters[:user_id]
      - author_label = @filter_customer ? "#{customer_display_name(@filter_customer)}さんの投稿" : "指定した投稿者の投稿"
      %li
        = link_to business_timeline_path(filters.merge(tab: @tab, user_id: nil).compact), class: "ba-chip is-active",
          "aria-label": "#{author_label}の絞り込みを解除" do
          = author_label
          %i.fa-solid.fa-xmark{ "aria-hidden": "true" }
    - if filters[:tag]
      %li
        = link_to business_timeline_path(filters.merge(tab: @tab, tag: nil).compact), class: "ba-chip is-active",
          "aria-label": "タグ「#{filters[:tag]}」の絞り込みを解除" do
          = "##{filters[:tag]}"
          %i.fa-solid.fa-xmark{ "aria-hidden": "true" }

- if @popular_tags.present?
  %section.ba-tag-filter{ "aria-labelledby": "popular-tags-title" }
    %h2.ba-label#popular-tags-title 人気タグ
    %ul.ba-chip-list
      - @popular_tags.each do |tag|
        - is_active = filters[:tag] == tag.name
        %li
          = link_to business_timeline_path(filters.merge(tab: @tab, tag: (is_active ? nil : tag.name)).compact),
            class: ["ba-chip", ("is-active" if is_active)], "aria-current": (is_active ? "true" : nil) do
            = tag.name
            %span.ba-count= tag.count

- if @posts.present?
  %ul.ba-project-grid.ba-section-body
    - @posts.each do |post|
      %li= render "business/posts/card", post: post, stats: true
  = paginate @posts
- else
  .ba-empty.ba-section-body
    %p.ba-empty__title= filters.values.any? ? "条件に合う投稿はありません" : "投稿がまだありません"
    - if feature_available?(:business_post_create)
      %p 活動の記録や、仲間に共有したい知見を投稿してみましょう。
      = link_to "投稿する", new_business_post_path, class: "ba-btn ba-btn--primary"
    - else
      = render "shared/feature_gate",
        feature_key: :business_post_create,
        title: "投稿を始める",
        class_name: "feature-gate--inline"
