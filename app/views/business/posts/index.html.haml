.ba-page-header
  .ba-page-header__text
    %h1.ba-page-title 投稿
    %p.ba-page-lead 活動の記録や知見を共有する投稿の一覧です。
  .ba-page-actions
    - if feature_available?(:business_post_create)
      = link_to new_business_post_path, class: "ba-btn ba-btn--primary" do
        %i.fa-solid.fa-plus{ "aria-hidden": "true" }
        投稿する

- unless feature_available?(:business_post_create)
  = render "shared/feature_gate",
    feature_key: :business_post_create,
    title: "ビジネス投稿を始める",
    message: "一覧や他の投稿はそのまま見られます。",
    class_name: "feature-gate--inline"

= form_with url: business_posts_path, method: :get, local: true, class: "ba-search", role: "search" do |f|
  = hidden_field_tag :user_id, params[:user_id]
  .ba-search__field
    %i.fa-solid.fa-magnifying-glass.ba-search__icon{ "aria-hidden": "true" }
    = f.text_field :keyword, value: params[:keyword], placeholder: "投稿を検索", class: "form-control", "aria-label": "投稿を検索"
  = f.submit "検索", class: "ba-btn ba-btn--primary"
  = link_to "クリア", business_posts_path(user_id: params[:user_id]), class: "ba-btn ba-btn--secondary"

- if @popular_tags.present?
  %section.ba-tag-filter{ "aria-labelledby": "popular-tags-title" }
    %h2.ba-label#popular-tags-title 人気タグ
    %ul.ba-chip-list
      - @popular_tags.each do |tag|
        - is_active = params[:tag] == tag.name
        %li
          = link_to business_posts_path(tag: tag.name, keyword: params[:keyword], user_id: params[:user_id]),
            class: ["ba-chip", ("is-active" if is_active)], "aria-current": (is_active ? "true" : nil) do
            = tag.name
            %span.ba-count= tag.count
        - if is_active
          %li
            = link_to business_posts_path(keyword: params[:keyword], user_id: params[:user_id]), class: "ba-chip", "aria-label": "タグ「#{tag.name}」の絞り込みを解除" do
              %i.fa-solid.fa-xmark{ "aria-hidden": "true" }
              解除

- if @posts.present?
  %ul.ba-project-grid.ba-section-body
    - @posts.each do |post|
      %li= render "business/posts/card", post: post, stats: true
- else
  .ba-empty.ba-section-body
    %p.ba-empty__title 投稿がまだありません
    - if feature_available?(:business_post_create)
      %p 最初の投稿をしてみましょう
      = link_to "投稿する", new_business_post_path, class: "ba-btn ba-btn--primary"
    - else
      = render "shared/feature_gate",
        feature_key: :business_post_create,
        title: "最初の投稿を始める",
        class_name: "feature-gate--inline"
