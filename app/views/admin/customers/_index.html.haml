.card.mb-3.shadow-sm
  .card-body
    = form_with url: admin_homes_top_path, method: :get, local: true do
      .row.g-3.align-items-end

        .col-md-2
          %label.form-label.fw-semibold
            %i.bi.bi-person-badge.me-1
            メンバータイプ
          = select_tag :member_type,
            options_for_select(enum_filter_options(MemberProfile.suggested_member_types, "enums.member_profile.suggested_member_type"), params[:member_type]),
            class: "form-select filter-select"

        .col-md-2
          %label.form-label.fw-semibold
            %i.bi.bi-music-note-list.me-1
            音楽経験
          = select_tag :music_experience_level,
            options_for_select(enum_filter_options(MemberProfile.music_experience_levels, "enums.member_profile.music_experience_level"), params[:music_experience_level]),
            class: "form-select filter-select"

        .col-md-2
          %label.form-label.fw-semibold
            %i.bi.bi-people.me-1
            関わり方
          = select_tag :engagement_style,
            options_for_select(enum_filter_options(MemberProfile.engagement_styles, "enums.member_profile.engagement_style"), params[:engagement_style]),
            class: "form-select filter-select"

        .col-md-2
          %label.form-label.fw-semibold
            %i.bi.bi-chat-dots.me-1
            連絡スタンス
          = select_tag :contact_preference,
            options_for_select(enum_filter_options(MemberProfile.contact_preferences, "enums.member_profile.contact_preference"), params[:contact_preference]),
            class: "form-select filter-select"

        .col-md-2
          %label.form-label.fw-semibold{ for: "last_login" }
            %i.bi.bi-clock-history.me-1
            最終ログイン
          = select_tag :last_login,
            options_for_select([["すべて", ""]] + AdminCustomers::ListFilter::LAST_LOGIN_OPTIONS.map { |key, option| [option[:label], key] }, params[:last_login]),
            class: "form-select filter-select"

        .col-md-2
          %label.form-label.fw-semibold{ for: "email_confirmation" }
            %i.bi.bi-envelope-check.me-1
            メール承認
          = select_tag :email_confirmation,
            options_for_select([["すべて", ""]] + AdminCustomers::ListFilter::EMAIL_CONFIRMATION_OPTIONS.map { |key, label| [label, key] }, params[:email_confirmation]),
            class: "form-select filter-select"

        .col-md-4
          .d-inline-flex.gap-2
            = submit_tag "絞り込み", class: "btn btn-primary px-4"
            = link_to "リセット", admin_homes_top_path, class: "btn btn-outline-secondary px-4"

-# 選択は sessionStorage に持つため、絞り込みを変えても選んだ会員は残る(admin_bulk_mail_selection.js)。
.card.mb-3.shadow-sm.admin-bulk-select{ data: { admin_bulk_select: true, matching_ids: matching_customer_ids.to_json } }
  .card-body.admin-bulk-select__body
    .admin-bulk-select__status
      選択中
      %strong{ data: { bulk_select_count: true } } 0
      件
    %button.btn.btn-outline-secondary.btn-sm{ type: "button", data: { bulk_select_clear: true } } 選択を解除
    %button.btn.btn-outline-primary.btn-sm{ type: "button", data: { bulk_select_all_matching: true } }
      条件に一致した人をすべて選択（#{matching_customer_ids.size}件）
    = form_with url: compose_admin_bulk_mails_path, method: :post, local: true, class: "admin-bulk-select__form", data: { bulk_select_form: true, turbolinks: false } do
      = hidden_field_tag :customer_ids, "", data: { bulk_select_ids: true }
      = submit_tag "選択したメンバーにメールを作成", class: "btn btn-primary btn-sm", disabled: true, data: { bulk_select_submit: true }


%table.table.table-striped.w-100.admin-table-sticky
  %thead
    %tr
      %th.admin-bulk-select__cell
        %span.sr-only 選択
      %th ID
      %th 名前
      %th ロール
      %th 最終ログイン日
      %th ログイン回数
      %th 契約プラン
      %th メンバータイプ
      %th ドメインタイプ
      %th 音楽経験
      %th 関わり方
      %th 連絡スタンス
      %th 詳細
      %th メール承認
      %th 物理削除

  %tbody
    - @customers.each do |customer|

      - row_class = nil
      - row_style = nil
      - if customer.music_user? && customer.business_user?
        - row_class = "table-warning"
      - elsif customer.music_user?
        - row_class = "table-primary"
      - elsif customer.business_user?
        - row_class = "table-success"
      - elsif customer.learning_user?
        - row_style = "background-color: #fff4e5;"
      - elsif customer.singing_user?
        - row_style = "background-color: #fff1f2;"

      %tr{ class: [row_class, ("table-secondary text-muted" if customer.is_deleted)].compact.join(" "), style: row_style }
        %td.admin-bulk-select__cell
          = check_box_tag "bulk_select_customer_ids[]", customer.id, false,
            id: "bulk-select-customer-#{customer.id}",
            class: "admin-bulk-select__checkbox",
            "aria-label": "会員 ID #{customer.id} を選択",
            data: { bulk_select_item: true }
        %th= customer.id
        %td
          .admin-customer-name
            = customer_avatar_tag(customer, class_name: "admin-customer-avatar")
            - if customer.is_deleted
              %span.badge.bg-secondary.text-white 退会済み
              %span.fw-semibold.text-decoration-line-through= customer.name
            - else
              %span.admin-customer-name__label= customer.name

        %td
          = admin_customer_role_badges(customer, @direct_owned_communities_by_customer_id[customer.id] || [])

        %td= customer.current_sign_in_at&.strftime('%Y/%m/%d') || '-'
        %td= "#{customer.sign_in_count}回"
        %td
          %span{ class: customer_plan_badge_class(customer) }= customer_plan_label(customer)

        %td
          = member_type_badge(customer.member_profile&.suggested_member_type)

        %td= domain_badges(customer)
        
        %td
          = music_experience_badge(customer.member_profile&.music_experience_level)

        %td
          = engagement_style_badge(customer.member_profile&.engagement_style)

        %td
          = contact_preference_badge(customer.member_profile&.contact_preference)

        %td
          = link_to "編集",
            edit_admin_customer_path(customer.id),
            method: :get,
            data: { 'turbolinks': false },
            class: "btn btn-info btn-sm"

        %td
          - if customer.confirmed_at.nil?
            = link_to "承認",
              approval_path(customer_id: customer.id),
              method: :patch,
              data: { 'turbolinks': false },
              class: "btn btn-primary btn-sm"
          - else
            承認済み

        %td
          -# 「退会」(編集画面の会員状態)とは別物。会員の行ごと消すため、ほかの会員との共有履歴も消えうる。
          = link_to "物理削除",
            purge_path(customer_id: customer.id),
            method: :delete,
            title: "通常の退会は「編集」→会員状態「退会」から行ってください",
            data: { confirm: "【物理削除・元に戻せません】会員 ID #{customer.id} のデータをデータベースから完全に削除します。投稿・チャット・イベント参加など、ほかの会員との共有履歴も消える場合があります。\n\n通常の退会は「編集」→会員状態「退会」から行ってください(共有履歴を残して個人情報だけを削除します)。\n\n本当に物理削除しますか？", 'turbolinks': false },
            class: "btn btn-outline-danger btn-sm"
