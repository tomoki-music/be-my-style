= render 'layouts/admin_header_menu'

.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-3
    %h2.mb-0= "Community詳細 ##{@community.id}"
    .btn-group
      = link_to "編集", edit_admin_community_path(@community), class: "btn btn-success"
      = link_to "削除", admin_community_path(@community), method: :delete, data: { confirm: "このコミュニティを削除しますか？" }, class: "btn btn-danger"

  .card.shadow-sm
    .card-body
      %dl.row.mb-0
        %dt.col-sm-3 名前
        %dd.col-sm-9= @community.name
        %dt.col-sm-3 ドメイン
        %dd.col-sm-9= @community.domain&.name
        %dt.col-sm-3 オーナー
        %dd.col-sm-9= @community.owner&.name || "未設定"
        %dt.col-sm-3 活動場所
        %dd.col-sm-9= @community.prefecture&.name
        %dt.col-sm-3 活動ペース
        %dd.col-sm-9= @community.human_attribute_enum(:activity_stance)
        %dt.col-sm-3 参加人数
        %dd.col-sm-9= @community.customers.count
        %dt.col-sm-3 ジャンル
        %dd.col-sm-9= @community.genres.pluck(:name).join(", ")
        %dt.col-sm-3 URL
        %dd.col-sm-9= @community.url.presence || "-"
        %dt.col-sm-3 紹介文
        %dd.col-sm-9= simple_format(@community.introduction)

  - if @community.business_domain?
    .card.shadow-sm.mt-3.admin-plan-trial-card#plan-trial
      .card-body
        .d-flex.flex-wrap.align-items-center.mb-2
          %h3.h5.mb-0.mr-2= plan_trial_label
          %span.badge{ class: @community.plan_restrictions_waived? ? "badge-success" : "badge-secondary" }
            現在：#{plan_trial_status_label(@community)}
        %p.mb-2= plan_trial_description
        %p.mb-1.font-weight-bold 無料で利用できるようになる機能
        %ul.mb-3
          - plan_trial_unlocked_features.each do |feature|
            %li= feature
        %p.small.text-muted
          対象はこのBusinessコミュニティ内だけです。他のコミュニティや、コミュニティ作成などコミュニティ外の機能、契約プラン・課金情報は変わりません。
        = form_with model: @community, url: admin_community_plan_trial_path(@community), method: :patch, local: true do |f|
          .custom-control.custom-switch.mb-3
            = f.check_box :plan_restrictions_waived, class: "custom-control-input", id: "admin_plan_restrictions_waived"
            %label.custom-control-label{ for: "admin_plan_restrictions_waived" }= plan_trial_label
          = f.submit "保存する", class: "btn btn-primary"

  .mt-3
    = link_to "一覧へ戻る", admin_communities_path, class: "btn btn-outline-secondary"
