= form_with model: [:admin, @event], local: true, html: { multipart: true } do |f|
  - if @event.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - @event.errors.full_messages.each do |message|
          %li= message

  .card.shadow-sm
    .card-body
      .form-row
        .form-group.col-md-6
          = f.label :event_name, "イベント名"
          = f.text_field :event_name, class: "form-control"
        .form-group.col-md-3
          = f.label :customer_id, "主催者"
          = f.collection_select :customer_id, Customer.order(:name), :id, :name, {}, class: "form-control"
        .form-group.col-md-3
          = f.label :community_id, @event.persisted? ? "主催コミュニティ" : "コミュニティ"
          = f.collection_select :community_id, Community.order(:name), :id, :name, {}, class: "form-control"

      - if @event.persisted?
        .form-group
          %label 開催コミュニティ
          = render "shared/event_hosting_communities_fields", f: f, event: @event, primary_change_available: true
        - current_primary = @event.primary_community_in_database
        .form-group.event-primary-change{ data: { current_primary_id: current_primary&.id, current_primary_name: current_primary&.name } }
          .form-check
            = f.check_box :keep_previous_primary_as_cohost, { class: "form-check-input" }, "1", "0"
            = f.label :keep_previous_primary_as_cohost, "主催を変更するとき、現在の主催「#{current_primary&.name}」を共催先として残す", class: "form-check-label"
          .alert.alert-warning.mt-2.mb-0.event-primary-change__preview{ hidden: true, role: "status" }

        :javascript
          (function () {
            var form = document.currentScript.closest("form");
            var section = form.querySelector(".event-primary-change");
            var select = form.querySelector("select[name='event[community_id]']");
            var keep = form.querySelector("input[type=checkbox][name='event[keep_previous_primary_as_cohost]']");
            var preview = section.querySelector(".event-primary-change__preview");
            function render() {
              var changed = select.value !== section.dataset.currentPrimaryId;
              preview.hidden = !changed;
              if (!changed) { return; }
              var nextName = select.options[select.selectedIndex].text;
              var currentName = section.dataset.currentPrimaryName;
              preview.textContent = "保存すると主催が「" + nextName + "」に変わり、「" + currentName + "」は" +
                (keep.checked ? "共催先に残ります。" : "共催先から外れます。") + "編集権限と自動リマインドの送信先は新しい主催が基準になります。";
            }
            select.addEventListener("change", render);
            keep.addEventListener("change", render);
            render();
          })();

      .form-row
        .form-group.col-md-4
          = f.label :event_start_time, "開始日時"
          = f.datetime_field :event_start_time, class: "form-control"
        .form-group.col-md-4
          = f.label :event_end_time, "終了日時"
          = f.datetime_field :event_end_time, class: "form-control"
        .form-group.col-md-4
          = f.label :event_entry_deadline, "参加締切"
          = f.datetime_field :event_entry_deadline, class: "form-control"

      .form-row
        .form-group.col-md-4
          = f.label :request_deadline, "リクエスト締切"
          = f.datetime_field :request_deadline, class: "form-control"
        .form-group.col-md-4
          = f.label :entrance_fee, "参加費"
          = f.number_field :entrance_fee, class: "form-control"
        .form-group.col-md-4
          = f.label :event_image, "イベント画像"
          = f.file_field :event_image, class: "form-control-file"

      .form-group
        %label 締め切り自動リマインド
        = render 'public/events/deadline_reminder_fields', f: f, event: @event,
          preview_url: @event.persisted? ? deadline_reminder_preview_admin_event_path(@event) : deadline_reminder_preview_admin_events_path

      .form-row
        .form-group.col-md-6
          = f.label :place, "開催場所"
          = f.text_field :place, class: "form-control"
        .form-group.col-md-6
          = f.label :address, "住所"
          = f.text_field :address, class: "form-control"

      .form-row
        .form-group.col-md-6
          = f.label :url, "参考URL"
          = f.text_field :url, class: "form-control"
        .form-group.col-md-6
          = f.label :url_comment, "URL説明"
          = f.text_field :url_comment, class: "form-control"

      .form-group
        = f.label :introduction, "イベント補足"
        = f.text_area :introduction, rows: 6, class: "form-control"

      %hr
      %h4 曲目
      %datalist#musical-key-options
        - Song::MUSICAL_KEY_CANDIDATES.each do |key|
          %option{ value: key }
      #songs.song-container
        = f.fields_for :songs do |song|
          - index = f.object.songs.index(song.object)
          .field.mb-4
            .song-header
              %strong= "#{index + 1}曲目"
            = render 'admin/events/song_fields', f: song
      .links.mb-3
        = link_to_add_association '曲を追加', f, :songs,
          class: 'btn btn-outline-success js-add-song-field-btn',
          data: { association: 'songs', association_insertion_method: 'append', association_insertion_node: '#songs' }
      = render 'public/events/song_template_picker'

      .d-flex.justify-content-between
        = link_to "一覧へ戻る", admin_events_path, class: "btn btn-outline-secondary"
        = f.submit (@event.persisted? ? "更新する" : "登録する"), class: "btn btn-primary"
