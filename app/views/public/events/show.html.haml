= render 'layouts/header_menu'
.event-show
  .event-show-title
    %h2 イベント詳細
    .event-show-follow
      = link_to '参加する🎵', '#event-songs', data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
      .event-request-icon
        = link_to '#event-request', class: "request-icon-text", data: { 'turbolinks': false } do
          %i.far.fa-comments.request-icon
          リクエストする

  .event-show-container.px-0.px-sm-0
    最終更新日:
    = l @event.updated_at, format: :short
    (
    = time_ago_in_words(@event.updated_at) + "前"
    )
    .row
      .col-md-3
        .event-show-card
          .card
            .img-container
              - if @event.event_image.present?
                = image_tag @event.event_image
              - else
                = image_tag 'no_image'
            .card-body.text-container
              %h5.card-title
                = @event.event_name
              %hr
              %h6.card-subtitle
                [イベント作成者]
                %br
                .event-owner-img
                  = customer_avatar_link(@owner)
                  .owner-name
                    = customer_profile_name_link(@owner)
              %hr
                .got-request-count
                  リクエスト数
                  %i.far.fa-comments
                  #got-request-count.count
                    = @event.requests.count
              %hr
              %p.card-text
              - if current_customer.can_edit_event?(@event)
                .mt-2
                  = link_to 'イベントの編集', edit_public_event_path(@event), data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
                  = link_to 'バンド出演枠', public_event_bands_path(@event), class: "btn btn-sm btn-info event-show-btn"
                  - if current_customer.can_destroy_event?(@event)
                    = link_to "コピーして新規作成", copy_public_event_path(@event), class: "btn btn-sm btn-info event-show-btn"

                    = render "shared/danger_zone_delete",
                      button_text: "イベント削除",
                      path: public_event_path(@event),
                      confirm_message: "このイベントを削除します。よろしいですか？"

                  %hr
                  = link_to '参加する🎵', '#event-songs', data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
                  = link_to 'リクエストする🎵', '#event-request', data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
              - else
                = link_to '参加する🎵', '#event-songs', data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
                = link_to 'リクエストする🎵', '#event-request', data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"

      .col-md-9
        .table-responsive(style="width: 100%;")
          -# 依頼UIを出せる権限者だけ、過去の演奏者欄を初期状態で折りたたむ(ページを開くたびにOFF)。
          %table.table.table-striped.event-show-table{ :border => "1", style: "width: 100%;", class: ("event-show-table--past-performers-collapsed js-past-performers-scope" if @entry_invitation_ui_enabled) }
            %colgroup
              %col{width: "19%"}
              %col{width: "81%"}
                %tr
                  %th{scope:"row"} 開催コミュニティ
                  %td
                    - @hosting_communities.each_with_index do |hosting_community, index|
                      - if index.positive?
                        \/
                      = link_to hosting_community.name, public_community_path(hosting_community), data: { turbolinks: false }
                    .text-red
                      - if @hosting_communities.one?
                        ※このイベントは【#{@hosting_communities.first.name}】に参加している必要があります。
                      - else
                        ※このイベントは【#{@hosting_communities.map(&:name).join("】【")}】のいずれかに参加している必要があります。
                %tr
                  %th{scope:"row"} イベント名
                  %td
                    = @event.event_name
                - if @event.url.present?
                  %tr
                    %th{scope:"row"} 参考URL
                    %td
                      .event-url
                        - text = @event.url
                        = link_to text, @event.url, target: :_blank, rel: "noopener noreferrer", data: { 'turbolinks': false }
                        %hr
                        = @event.url_comment
                %tr
                  %th{scope:"row"} 開始時間
                  %td
                    %h4.font-weight-bold
                      <i class="far fa-clock"></i>
                      = l @event.event_start_time, format: :short
                %tr
                  %th{scope:"row"} 終了時間
                  %td
                    %h4.font-weight-bold
                      <i class="far fa-clock"></i>
                      = l @event.event_end_time, format: :short
                %tr
                  %th{scope:"row"} 参加費用
                  %td
                    %h5.font-weight-bold
                      <i class="fa-solid fa-sack-dollar"></i>
                      = @event.entrance_fee.to_s(:delimited) + "円"
                    - if current_customer.paid_plan?
                      - credit_month = @event.event_start_time.in_time_zone.month
                      .session-credit-panel
                        - if @current_customer_event_credit_applied
                          %span.session-credit-panel__badge このイベントに適用済み
                          %p
                            このイベントには#{credit_month}月分の有料プラン特典として
                            %strong= "#{@current_customer_session_credit_amount.to_s(:delimited)}円分"
                            が適用済みです。
                          .session-credit-panel__breakdown
                            .session-credit-panel__row
                              %span.session-credit-panel__label イベント参加費
                              %strong= "#{@event.entrance_fee.to_s(:delimited)}円"
                            .session-credit-panel__row
                              %span.session-credit-panel__label 特典適用
                              %strong.session-credit-panel__discount
                                = "-#{@current_customer_session_credit_amount.to_s(:delimited)}円"
                            .session-credit-panel__row.session-credit-panel__row--total
                              %span.session-credit-panel__label 当日のお支払い
                              %strong= "#{@current_customer_remaining_fee.to_s(:delimited)}円"
                          - if @current_customer_remaining_fee.zero?
                            %p.session-credit-panel__free 現地集金は不要です。
                        - elsif @current_customer_session_credit_available
                          %span.session-credit-panel__badge= "#{credit_month}月分の特典対象"
                          %p
                            有料プラン特典として、
                            %strong= "#{@current_customer_session_credit_amount.to_s(:delimited)}円分"
                            をこのイベントに適用できます。
                          .session-credit-panel__breakdown
                            .session-credit-panel__row
                              %span.session-credit-panel__label イベント参加費
                              %strong= "#{@event.entrance_fee.to_s(:delimited)}円"
                            .session-credit-panel__row
                              %span.session-credit-panel__label 特典適用
                              %strong.session-credit-panel__discount
                                = "-#{@current_customer_session_credit_amount.to_s(:delimited)}円"
                            .session-credit-panel__row.session-credit-panel__row--total
                              %span.session-credit-panel__label 当日のお支払い
                              %strong= "#{@current_customer_remaining_fee.to_s(:delimited)}円"
                          - if @current_customer_remaining_fee.zero?
                            %p.session-credit-panel__free 現地集金は不要です。
                          - else
                            %p.session-credit-panel__remaining
                              今回は特典の
                              %strong 1,500円分のみ
                              が適用されるため、当日は残額のみのお支払いです。
                            %p.session-credit-panel__hint
                              スタッフ向け表示でも「有料プラン」「集金不要 / 残額あり」が分かるようになります。
                        - else
                          %span.session-credit-panel__badge.session-credit-panel__badge--muted= "#{credit_month}月分の特典は使用済み"
                          %p
                            #{credit_month}月分の1,500円特典は、同じ開催月の別イベントで利用済みです。
                          .session-credit-panel__breakdown
                            .session-credit-panel__row.session-credit-panel__row--total
                              %span.session-credit-panel__label 今回の当日支払い
                              %strong= "#{@event.entrance_fee.to_s(:delimited)}円"
                %tr
                  %th{scope:"row"} 開催場所
                  %td
                    %h5.font-weight-bold
                      <i class="fa-solid fa-earth-asia"></i>
                      = @event.place
                %tr
                  %th{scope:"row"} 開催場所（地図）
                  %td
                    .map-wrapper
                      #map
                %tr
                  %th{scope:"row"} 参加人数
                  %td
                    .font-weight-bold
                      <i class="fa-solid fa-people-group"></i>
                      #{@joined_member_counts}人
                - if @join_members.present?
                  %tr 
                    %th{scope:"row"} 参加メンバー
                    %td
                      .join-member-list
                        - @join_members.each do |customer|
                          = link_to public_customer_path(customer), class: 'image-style', data: { 'turbolinks': false } do
                            = customer_avatar_tag(customer, class_name: "icon_mini")
                            = customer.name
                          - if @event.paid_participant_for_display?(customer)
                            %span.member-plan-badge.member-plan-badge--paid
                              %i.fa-solid.fa-star
                              有料プラン
                          - if @event.session_credit_applied_for?(customer)
                            - if @event.participant_remaining_fee_for(customer).zero?
                              %span.member-plan-badge.member-plan-badge--credit
                                %i.fa-solid.fa-sparkles
                                集金不要
                            - else
                              %span.member-plan-badge.member-plan-badge--credit-partial
                                %i.fa-solid.fa-sparkles
                                当日集金 #{@event.participant_remaining_fee_for(customer).to_s(:delimited)}円
                          %br
                          %hr
                %tr
                  %th{scope:"row"} 成立楽曲数
                  %td
                    %h4.text-red
                      #{@complete_count}曲 成立!!
                    (全#{@event.songs.length}曲)
                - if @event.event_entry_deadline.present?
                  %tr
                    %th{scope:"row"} 参加締切日
                    %td
                      %h5.font-weight-bold
                        = l @event.event_entry_deadline, format: :short
                        まで
                %tr.event-songs-section-row
                  %th{scope:"row"} 楽曲
                  %td{colspan: "100"}
                    %h5.event-songs-mobile-heading.d-md-none 楽曲
                    - if @event.event_bands.any?
                      = render "public/events/bands", bands: @event.event_bands, event: @event, can_cheer: @can_cheer
                    = form_tag(public_event_join_confirm_path(@event), method: :get, id: 'join_btn', onSubmit: "return CheckJoin()") do
                      #event-songs.event-songs-join-form
                        %div{ style: "display: flex; justify-content: flex-start; align-items: center; margin-bottom: 12px;" }
                          %div{ style: "display: flex; align-items: center; gap: 12px;" }
                            %button.btn.btn-sm.btn-outline-info#help-popover{
                              type: "button",
                              data: {
                                toggle: "popover",
                                html: "true",
                                content: "①ご希望の「参加パート」にチェックを入れてください。（複数チェック可）<br><br>②「参加確認画面へ」のボタンを押して内容に間違いなければ「参加する」ボタンで確定してください。<br><br>③参加が確定すると楽曲一覧表にご自身のアイコンが表示されます。<br><br>※ご注意※<br>③で参加ができない場合：事前に「開催コミュニティ」へ参加申請を行って下さい。<br><br>【ご参考】<br>現在の参加メンバーは一覧表を右スクロールすると全体像が確認できます🎵",
                                placement: "bottom"
                              }
                            }
                              ?
                            %input#submit_join_form{
                              type: "submit",
                              value: "参加確認画面へ",
                              class: "btn btn-lg btn-primary",
                              style: "padding: 12px 32px; font-size: 1.2rem; min-width: 220px; white-space: nowrap;",
                              disabled: true,
                              data: {'disable_with': '送信中...', 'turbolinks': false}
                            }
                        
                        %div.filter-buttons{ style: "margin-bottom: 12px;" }
                          %button.btn.btn-outline-primary#filter-all(type="button") すべて表示
                          %button.btn.btn-outline-success#filter-complete(type="button") 楽曲成立
                          %button.btn.btn-outline-warning#filter-vacant(type="button") 募集中
                          - if @entry_invitation_ui_enabled
                            %button.btn.btn-outline-secondary.past-performers-toggle.js-past-performers-toggle{ type: "button",
                              "aria-expanded": "false",
                              "aria-controls": "event-songs entry-invitation-request-row",
                              data: { label_show: "過去に演奏した人を表示する", label_hide: "過去に演奏した人を非表示にする" } }
                              過去に演奏した人を表示する

                        %div.responsive-wrapper{ style: "position: relative;" }
                          %div.scroll-indicator{id: "scroll-indicator"} →
                          %div.responsive-box
                            - part_names = JoinPart::NAME_OPTIONS
                            -# table-layout:fixed のため列幅は先頭行の width で決まる(min-width は効かない)。
                            -# 列数(2 + パート数)で等分した%指定にし、PC(768px以上、.event-songs-tableのwidth:100%)で
                            -# テーブルが画面幅いっぱいに広がるほど各列も比例して広がるようにする。
                            -# min-widthはこれまでどおり候補カードが読める幅(160px)換算の合計(160 * 列数)を保ち、
                            -# スマホ(768px未満)はCSSで1曲1行の表示に組み替えるため、min-widthはCSS変数で渡す。
                            - column_count = part_names.size + 3
                            - column_width_percent = (100.0 / column_count).round(4)
                            %table.table.table-bordered.event-songs-table{ style: "--event-songs-min-width: #{160 * column_count}px; table-layout: fixed;" }
                              %thead
                                %tr
                                  %th{ style: "width: #{column_width_percent}%;" } 曲名 / ステータス
                                  %th{ style: "width: #{column_width_percent}%;" } 参加フォーム
                                  - part_names.each do |part|
                                    %th{ style: "width: #{column_width_percent}%;" }= part
                                  %th{ style: "width: #{column_width_percent}%;" } 応援する📣
                              -# 一覧の「募集中」から直接申し込めるのは、参加チェック欄を出す条件(未終了)と
                              -# サーバー側の受付条件(開催コミュニティの所属者 = @can_cheer と同じ判定)を満たす場合だけ。
                              - quick_entry_enabled = @can_cheer && @event.event_end_time > Time.now
                              %tbody
                                - @event.songs.each do |song|
                                  - recruiting_parts = song.recruiting_join_parts
                                  - vacant = recruiting_parts.any?
                                  - song_details_id = "event-song-details-#{song.id}"
                                  %tr.event-song-row{ id: song_details_id, class: [(vacant ? 'vacant' : 'complete'), ('band' if song.band_performance?)] }
                                    %td.event-song-row__main
                                      .event-song-row__head
                                        .event-song-row__badges
                                          - if song.band_performance?
                                            %span.badge.badge-info バンド出演🎸
                                            %div.song-band-name
                                              = link_to song.event_band.name, "#event-band-#{song.event_band_id}", data: { turbolinks: false }
                                            -# スマホの1曲1行表示では、パート列の代わりに固定メンバーをここに出す。
                                            .song-band-members.d-md-none
                                              - song.event_band.ordered_members.each do |member|
                                                %span.song-band-members__item #{member.part_name}: #{member.label}
                                          - elsif vacant
                                            %span.badge.badge-warning 募集中!!
                                          - else
                                            %span.badge.badge-success 楽曲成立🎵
                                          %br
                                          - if song.performance_start_time.present?
                                            %span.song-start-time
                                              = "開始 #{song.performance_start_time}"
                                            %br
                                        %button.song-row-toggle.d-md-none{ type: "button",
                                          "aria-expanded": "false",
                                          "aria-controls": song_details_id,
                                          data: { label_open: "詳細・エントリー ▼", label_close: "閉じる ▲" } }
                                          %span.song-row-toggle__label 詳細・エントリー ▼
                                          %span.song-row-toggle__selected{ hidden: true } 選択中
                                      %div{ style: "white-space: normal; word-break: break-word;" }
                                        = link_to song.song_name, public_event_song_path(@event, song), class: "song-detail-link", data: { turbolinks: false }
                                      - unless song.band_performance?
                                        -# スマホの1曲1行表示用。PC表と同じ判定で各パートの状況を文字でも示す。
                                        %ul.song-part-summary.d-md-none{ "aria-label": "#{song.song_name}のパート別状況" }
                                          - song_part_summaries(song, recruiting_parts).each do |summary|
                                            - quick_entry = quick_entry_enabled && summary.entry_join_part_id
                                            %li.song-part-summary__item{ class: ["song-part-summary__item--#{summary.state}", ("song-part-summary__item--actionable" if quick_entry)] }
                                              - if quick_entry
                                                -# 同じ参加フォームのチェック欄を選んで送信するだけ(確定は確認画面の後)。
                                                %button.song-part-summary__entry{ type: "button",
                                                  data: { join_part_id: summary.entry_join_part_id },
                                                  "aria-label": "#{song.song_name}の#{summary.label}で参加確認へ進む" }
                                                  = render "public/events/song_part_summary_text", summary: summary
                                              - else
                                                = render "public/events/song_part_summary_text", summary: summary
                                      .song-row-details
                                        - if song.requested_by_customer.present?
                                          %div.song-requester.text-muted{ style: "font-size: 0.85em;" }
                                            %i.fa-solid.fa-user
                                            リクエスト：
                                            = customer_profile_name_link(song.requested_by_customer)
                                            さん
                                        = render "public/events/youtube_card", card: youtube_card_for(song)

                                    %td.event-song-row__detail{ data: { mobile_label: "参加フォーム" } }
                                      .check-part-list
                                        - if song.band_performance?
                                          %span.song-band-note バンド出演曲のため一般エントリーはありません
                                        - elsif @event.event_end_time > Time.now
                                          - song.join_parts.each do |part|
                                            .check-part-item(style="margin-bottom: 4px;")
                                              = label_tag "event_join_part_ids_#{part.id}" do
                                                = check_box_tag "event[join_part_ids][]", part.id, false, id: "event_join_part_ids_#{part.id}", class: "js-join-part-checkbox"
                                                = part.join_part_name
                                              = hidden_field_tag :event_id, @event.id
                                        - else
                                          終了イベントのためチェック不可

                                    - part_names.each do |part_name|
                                      -# 生の完全一致ではなくPartNameNormalizer経由で正規化し、旧表記のJoinPartも
                                      -# 対応する固定列へ寄せる。同じ正規化パートに複数JoinPartがあり得るため各件を描画する。
                                      - column_join_parts = normalized_join_parts_for_column(song, part_name)
                                      - empty_cell = song.band_performance? ? song.event_band.member_for(part_name).nil? : column_join_parts.empty?
                                      %td.event-song-row__detail{ class: ("event-song-row__detail--empty" if empty_cell), data: { mobile_label: part_name } }
                                        - if song.band_performance?
                                          -# バンド出演曲は固定メンバーだけを表示し、募集・経験者・エントリー依頼は出さない。
                                          - band_member = song.event_band.member_for(part_name)
                                          - if band_member&.customer_member?
                                            .member-display.song-band-member
                                              = link_to public_customer_path(band_member.customer), data: { turbolinks: false } do
                                                = customer_avatar_tag(band_member.customer, class_name: "icon_mini")
                                                = band_member.customer.name
                                          - elsif band_member
                                            .member-display.song-band-member= band_member.label
                                          - else
                                            ー
                                        - elsif column_join_parts.present?
                                          - column_join_parts.each do |join_part|
                                            -# active_customers(customers.active)はloadedな関連でも再クエリするため、
                                            -# preload済みのjoin_part.customersからis_deletedを除外してN+1を避ける。
                                            - part_members = join_part.customers.reject(&:is_deleted)
                                            - part_member_ids = join_part.customers.map(&:id)
                                            - if part_members.any?
                                              - part_members.each do |customer|
                                                .member-display(style="display:flex; flex-direction:column; align-items:flex-start; gap:4px; margin-bottom:4px;")
                                                  = link_to public_customer_path(customer), data: { turbolinks: false } do
                                                    = image_tag(customer.profile_image.presence || 'no_image',
                                                                class: "icon_mini",
                                                                style: "width:24px; height:24px; border-radius:50%; object-fit:cover; #{image_position_style(customer, :profile_image)}")
                                                    = customer.name
                                                  - if @event.paid_participant_for_display?(customer)
                                                    %span.member-plan-badge.member-plan-badge--paid
                                                      %i.fa-solid.fa-star
                                                      有料
                                                  - if @event.session_credit_applied_for?(customer)
                                                    - if @event.participant_remaining_fee_for(customer).zero?
                                                      %span.member-plan-badge.member-plan-badge--credit
                                                        %i.fa-solid.fa-sparkles
                                                        集金不要
                                                    - else
                                                      %span.member-plan-badge.member-plan-badge--credit-partial
                                                        %i.fa-solid.fa-sparkles
                                                        当日集金 #{@event.participant_remaining_fee_for(customer).to_s(:delimited)}円
                                                  - if customer == current_customer && part_members.include?(current_customer) && @event.join_cancellable?
                                                    = link_to "削除",
                                                      public_event_delete_path(@event, join_part_id: join_part.id, customer_id: customer.id),
                                                      method: :delete,
                                                      data: { confirm: "この参加をキャンセルしますか？" },
                                                      class: "btn btn-danger w-100"
                                            - else
                                              %span.text-danger 募集中
                                            -# 経験者集合から現在参加者をCustomer IDで差し引き、同じセルに二重表示しない。
                                            - candidates = experienced_customers_for_display(song, join_part.join_part_name, exclude_customer_ids: part_member_ids)
                                            - if @entry_invitation_ui_enabled
                                              = render "public/events/entry_invitation_candidates", song: song, join_part: join_part, customers: candidates, current_member_ids: part_member_ids
                                            - else
                                              = render "public/events/experienced_customers", customers: candidates
                                        - else
                                          ー
                                    %td.song-cheer-cell.event-song-row__detail{ data: { mobile_label: "応援する📣" } }
                                      = render "public/events/song_cheer", song: song, event: @event, can_cheer: @can_cheer
                - if @entry_invitation_ui_enabled
                  -# 見出し・説明・送信ボタン・確認画面へのGETフォームだけを、楽曲表の横スクロール
                  -# 領域外(この%td)へ置く。対象者のチェックボックスは楽曲表の各パート欄にあり、
                  -# HTML5の form= 属性でこのフォームへ紐付く(フォームの入れ子は作らない)。
                  - entry_invitation_selectable = entry_invitation_has_selectable_candidate?
                  %tr.entry-invitation-row#entry-invitation-request-row
                    %td{ colspan: "100" }
                      = form_tag new_public_event_entry_invitation_path(@event), method: :get, id: "entry-invitation-form", class: "entry-invitation-form" do
                        %h3.entry-invitation-form__title 演奏経験者へエントリーをお願いする
                        %p.entry-invitation-form__desc
                          楽曲表の各パート欄で対象者にチェックを入れ、確認画面へ進んでください。メールと通知は曲・パートごとに届きます。
                        %p.entry-invitation-form__mobile-hint.d-md-none
                          曲の「詳細・エントリー」を開いて、依頼したいメンバーを選択してください。
                        - unless entry_invitation_selectable
                          %p.entry-invitation-form__empty{ role: "status" } 現在、依頼できる演奏経験者はいません。
                        -# 初期状態は常に disabled。JS が有効な .js-entry-invitation-checkbox の
                        -# checked 件数を見て有効化する(参加フォームのボタン制御とは完全に分離)。
                        -# JS 無効時はサーバー側 TargetParser / TargetResolver / BatchSender が空選択を弾く。
                        = submit_tag "選択した人へエントリーをお願いする",
                          class: "btn btn-info js-entry-invitation-submit entry-invitation-form__submit",
                          disabled: true,
                          data: { disable_with: "確認画面へ移動中..." }
                %tr
                  %th{scope:"row"} イベント補足
                  %td
                    %div.markdown-body
                      = markdown(@event.introduction)

                - if @owner == current_customer || @can_download_performance_list
                  %tr
                    %th{scope:"row"} ダウンロード
                    %td
                      - if @owner == current_customer
                        = link_to "参加一覧ダウンロード", public_event_path(@event, format: :csv), data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
                      - if @can_download_performance_list
                        = link_to "演奏リスト（Excel）", performance_list_public_event_path(@event), data: { 'turbolinks': false }, class: "btn btn-sm btn-info event-show-btn"
                      - if @owner == current_customer
                        %p.mt-2.mb-0.text-muted
                          CSVには有料プラン参加者と、今月特典適用済みユーザーがわかる表記を含めています。
                        %p.mb-0.text-muted
                          参加費が1,500円を超えるイベントでも、現地集金が必要な参加者を見分けやすくしています。
                      - if @can_download_performance_list
                        %p.mt-2.mb-0.text-muted
                          演奏リストは曲順・パートごとの出演者(表示名)を載せた共有用の表です。共有フォルダURLと演奏動画URLは空欄なので、必要に応じて追記してください。
        #event-request.event-request{ data: { "mention-candidates-url" => mention_candidates_public_event_path(@event), "current-customer-id" => current_customer.id } }
          - if @event.request_deadline.present?
            .event-request-deadline
              曲リクエスト締切日:
              %h5
                = l @event.request_deadline, format: :short
                まで
          = render 'public/requests/form', event: @event, request: @request
          #event-request-asy.request-part
            = render 'public/requests/requests', event: @event

  %div{type: "text/javascript"}
    :javascript
      function CheckJoin(){
        if(confirm("参加申請しますか？")){
          return true; 
        }else{
          alert('キャンセルされました'); 
          location.reload();
          return false; 
        }
      }

  - latitude = @latitude
  - longitude = @longitude
  - address = @address

  %div{type: "text/javascript"}
    :javascript
      function initMap() {
        var test = {lat: #{latitude}, lng: #{longitude}};
        var map = new google.maps.Map(document.getElementById('map'), {
                  zoom: 15, 
                  center: test
                  });
        var transitLayer = new google.maps.TransitLayer();
        transitLayer.setMap(map);

        var contentString = "住所： #{address}";
        var infowindow = new google.maps.InfoWindow({
          content: contentString
        });

        var marker = new google.maps.Marker({
                      position:test,
                      map: map,
                      title: contentString
                      });

        marker.addListener('click', function() {
          infowindow.open(map, marker);
        });
      }
  %script{async: "", defer: "defer", src: "https://maps.googleapis.com/maps/api/js?key=#{Rails.application.credentials.map_api_key}&callback=initMap"}
  
