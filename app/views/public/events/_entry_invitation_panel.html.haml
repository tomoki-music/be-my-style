-# 演奏経験者へのエントリー依頼パネル(主催者向け)。
-# 表示条件(呼び出し側 show.html.haml): 送信権限あり(can_destroy_event?)かつイベント未終了。
-# パネル全体で 1 つの GET フォーム。曲・パートをまたいで選んだ候補を
-# targets[]="song_id:join_part_id:customer_id" 形式でまとめて確認画面へ渡す。
-# 送信ボタンはパネル内に 1 つだけ。メール・通知は確認画面以降で曲・パート単位に送られる。
- panel_blocks = event.songs.flat_map do |song|
  - song.recruiting_join_parts.filter_map do |part|
    - experienced = experienced_customers_for(song, part.join_part_name)
    - next if experienced.blank?
    - { song: song, part: part, experienced: experienced }

- if panel_blocks.present?
  .entry-invitation-panel
    %h3.entry-invitation-panel__title 演奏経験者へエントリーをお願いする
    %p.entry-invitation-panel__desc
      過去に同じ楽曲・パートで演奏経験のある人へ、エントリー依頼メールを送れます。曲・パートをまたいで、送りたい人だけを選んでください。
    = form_tag new_public_event_entry_invitation_path(event), method: :get, class: "entry-invitation-panel__form" do
      - panel_blocks.each do |block|
        - song = block[:song]
        - part = block[:part]
        .entry-invitation
          %h4.entry-invitation__heading
            = song.song_name
            %span.entry-invitation__part= part.join_part_name
          %ul.entry-invitation__list
            - block[:experienced].each do |customer|
              - invitation = entry_invitation_for(song, part, customer)
              - checkbox_id = "entry_invitation_target_#{song.id}_#{part.id}_#{customer.id}"
              %li.entry-invitation__item
                = check_box_tag "targets[]", "#{song.id}:#{part.id}:#{customer.id}", false, id: checkbox_id, class: "js-entry-invitation-checkbox"
                = label_tag checkbox_id, class: "entry-invitation__label" do
                  = customer_avatar_tag(customer, class_name: "icon_mini")
                  %span.entry-invitation__name= customer.name
                = link_to "プロフィール", public_customer_path(customer), class: "entry-invitation__profile", data: { turbolinks: false }
                - status_label = entry_invitation_status_label(invitation)
                - if status_label
                  %span.entry-invitation__status{ class: ("entry-invitation__status--failed" if invitation.failed?) }= status_label
      .entry-invitation-panel__actions
        %button.btn.btn-info.js-entry-invitation-submit{ type: "submit" } 選択した人へエントリーをお願いする
