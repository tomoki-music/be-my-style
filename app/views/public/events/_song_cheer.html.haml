-# 楽曲の「応援する📣」。楽曲表と曲詳細の両方で使う。
= render "public/events/cheer_box",
  customers: song.active_cheer_customers,
  cheered: song.cheered_by?(current_customer),
  path: public_event_song_cheer_path(event, song),
  button_label: "応援する📣",
  subject_name: song.song_name,
  can_cheer: can_cheer,
  event: event
