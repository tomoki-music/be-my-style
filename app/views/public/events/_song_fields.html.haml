.nested-fields{ data: { id: f.object.id } }
  = f.hidden_field :position, class: 'song-position', value: (f.object.try(:position) || '')
  = f.hidden_field :event_id, value: f.object.event_id
  .song-layout
    .song-header
      %span.drag-handle ⇅
      %button.btn.btn-sm.btn-outline-info.ml-2#drag-help-btn{ type: "button", data: { toggle: "popover", html: true, content: "上下にドラッグすると曲の順番を並べ替えできます。", placement: "left" } }
        ?
    .field
      = f.text_field :song_name, placeholder: "楽曲名"
    .field
      = f.text_field :artist_name, placeholder: "アーティスト名"
    .field
      = f.text_field :performance_start_time, placeholder: "演奏開始時間（例: 19:30）"
    .field
      = f.text_field :performance_time, placeholder: "演奏時間（例: 04:30）"
    .field
      = f.text_field :youtube_url, placeholder: "Youtubeの動画URL"
    .field
      = f.text_field :chord_sheet_url, placeholder: "コード譜URL"
    .field
      = f.text_field :tab_sheet_url, placeholder: "TAB譜URL"
    .field
      = f.text_field :musical_key, placeholder: "Key（例：G、Am）", list: "musical-key-options"
    .field
      = f.number_field :capo, placeholder: "Capo（0〜12、未入力なら不明）", min: 0, max: 12, step: 1
    .field
      = f.text_area :chord_sheet_note, placeholder: "コード譜メモ（例：初心者向け簡単コード版）", rows: 2, class: "form-control"
    .field
      = f.text_area :introduction, placeholder: "楽曲の紹介文（意気込みや想いなど）", rows: 3, class: "form-control"
    .field
      = f.label :requested_by_customer_id, "リクエストした人"
      - if @template_community.present?
        = f.collection_select :requested_by_customer_id, @requested_by_customer_candidates, :id, :name, { include_blank: "指定なし" }, class: "form-control"
      - else
        = f.select :requested_by_customer_id, [], {}, { class: "form-control", disabled: true }
        %small.form-text.text-muted コミュニティ確定後に設定できます
    .field
      = link_to_remove_association '曲を削除', f, class: 'btn btn-danger js-song-remove-btn', data: { 'turbolinks': false, confirm: 'こちらの曲を削除します。よろしいですか？' }
    #join_parts.join-part-layout
      = f.fields_for :join_parts, id: 'js-join-part-field' do |join_part|
        .field
          = render 'public/events/join_part_fields', f: join_part
      .links
        = link_to_add_association 'パートを追加', f, :join_parts,
          class: 'btn btn-success js-add-join-part-field-btn',
          data: { 'turbolinks': false }
