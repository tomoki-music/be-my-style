.nested-fields.video-caption-fields{ data: { id: f.object.id } }
  .video-caption-fields__row
    .field.video-caption-fields__time
      = f.label :start_time, "開始(秒)"
      .video-caption-fields__time-input
        = f.number_field :start_time, step: 0.1, min: 0, class: "form-control video-caption-fields__start-time"
        %button.btn.btn-sm.btn-outline-secondary.video-caption-fields__seek-btn{ type: "button", "aria-label": "この位置を動画で確認" }
          ▶
    .field.video-caption-fields__time
      = f.label :end_time, "終了(秒)"
      = f.number_field :end_time, step: 0.1, min: 0, class: "form-control"
    .field.video-caption-fields__type
      = f.label :caption_type, "種別"
      = f.select :caption_type, VideoCaption::CAPTION_TYPE_LABELS.map { |value, label| [label, value] }, {}, class: "form-control"
  .field.video-caption-fields__text
    = f.label :text, "テロップ本文"
    = f.text_area :text, rows: 2, maxlength: VideoCaption::TEXT_MAX_LENGTH, class: "form-control"
  = link_to_remove_association "このテロップを削除", f, class: "btn btn-sm btn-outline-danger video-caption-fields__remove-btn", data: { 'turbolinks': false, confirm: "このテロップを削除します。よろしいですか？" }
