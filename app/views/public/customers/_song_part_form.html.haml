.song-part-form
  = form_with model: CustomerSongPart.new, url: public_customer_song_parts_path, method: :post, local: true, class: "song-part-form__form" do |f|
    - if @eligible_songs_for_song_part.present?
      .song-part-form__row
        = f.label :song_id, "既存の曲から選ぶ", class: "song-part-form__label"
        = f.select :song_id,
          @eligible_songs_for_song_part.map { |song| [song.artist_name.present? ? "#{song.song_name} / #{song.artist_name}" : song.song_name, song.id] },
          { include_blank: "選択しない(下に自由入力する)" },
          { class: "form-control song-part-form__select" }
    - else
      %p.text-muted 所属コミュニティのイベントに登録された曲はまだありませんが、下記から自由入力で登録できます。

    %p.song-part-form__hint 上で曲を選ばない場合は、下記に曲名・アーティスト名を自由入力してください(イベントに存在しない曲も登録できます)。

    .song-part-form__row
      = f.label :song_name, "曲名(自由入力)", class: "song-part-form__label"
      = f.text_field :song_name, maxlength: Public::CustomerSongPartsController::MAX_TEXT_LENGTH, class: "form-control song-part-form__input"
    .song-part-form__row
      = f.label :artist_name, "アーティスト名(自由入力・任意)", class: "song-part-form__label"
      = f.text_field :artist_name, maxlength: Public::CustomerSongPartsController::MAX_TEXT_LENGTH, class: "form-control song-part-form__input"

    .song-part-form__row
      = f.label :part_name, "パート", class: "song-part-form__label"
      = f.select :part_name,
        JoinPart::NAME_OPTIONS.map { |name| [name, name] },
        { prompt: "パートを選択してください" },
        { class: "form-control song-part-form__select" }

    = f.submit "追加", class: "btn btn-info song-part-form__submit"

  - if @customer_song_parts.present?
    %ul.song-part-form__list
      - @customer_song_parts.each do |customer_song_part|
        %li.song-part-form__item
          %span.song-part-form__song
            = customer_song_part.song_master&.song_name
            - if customer_song_part.song_master&.artist_name.present?
              %span.song-part-form__artist
                / #{customer_song_part.song_master.artist_name}
          %span.song-part-form__part= customer_song_part.part_name
          = link_to "削除", public_customer_song_part_path(customer_song_part),
            method: :delete,
            data: { confirm: "この演奏可能曲を削除します。よろしいですか？", turbolinks: false },
            class: "btn btn-sm btn-outline-danger song-part-form__delete"
  - else
    %p.text-muted 登録済みの演奏可能曲はありません。
