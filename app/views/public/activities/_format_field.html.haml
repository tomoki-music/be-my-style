-# 活動報告の Markdown 本文欄に、チャット欄と同じ装飾ボタン+「文字色」+編集/プレビュー切り替えを付ける。
-# 動作は public/requests/request_markdown_toolbar.js(data-markdown-toolbar-root)が担う。
-# プレビューは保存後の詳細画面と同じ描画(activity_markdown)をサーバーから受け取る。
- palette_id = "activity-format-palette-#{field}"
.activity-format-field{ data: { "markdown-toolbar-root" => "activity-#{field}", "preview-url" => preview_public_activities_path } }
  .activity-format-toolbar{ role: "toolbar", "aria-label" => "文字の装飾" }
    - activity_format_buttons.each do |action, icon, label, title|
      %button.activity-format-toolbar__btn{ type: "button", data: { "md-action" => action }, title: title, "aria-label" => title }
        %span.activity-format-toolbar__icon{ class: "activity-format-toolbar__icon--#{action}", "aria-hidden" => "true" }= icon
        %span= label
    %button.activity-format-toolbar__btn{ type: "button", data: { "md-action" => "color-menu" }, title: "選んだ文字に色を付ける", "aria-label" => "文字色を選ぶ", "aria-expanded" => "false", "aria-controls" => palette_id }
      %span.activity-format-toolbar__color-icon{ "aria-hidden" => "true" } A
      %span 文字色
    %button.activity-format-toolbar__btn.activity-format-toolbar__btn--preview{ type: "button", data: { "md-action" => "preview" }, "aria-pressed" => "false", title: "保存後の見え方をプレビューする", "aria-label" => "保存後の見え方をプレビューする" }
      プレビュー
    .activity-format-toolbar__palette{ id: palette_id, hidden: true, data: { "md-color-palette" => "true" } }
      - activity_text_color_options.each do |color, label|
        %button.activity-format-toolbar__swatch{ type: "button", data: { "md-action" => "color", "md-color" => color }, "aria-label" => "文字色を#{label}にする" }
          %span.activity-format-toolbar__dot{ class: "activity-format-toolbar__dot--#{color}", "aria-hidden" => "true" }
          %span{ class: "md-text-color md-text-color--#{color}" }= label
  .request-markdown-toolbar__pane--edit
    = yield
  .request-markdown-toolbar__pane--preview.activity-format-preview{ hidden: true }
    .markdown-body.request-markdown-toolbar__preview-body
      %p.markdown-preview-placeholder プレビューする内容がありません
