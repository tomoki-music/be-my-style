-# 楽曲詳細ページの「参加状況」。募集中/成立の判定・経験者表示・エントリー導線は
-# すべてPublic::EventsController#show(楽曲一覧)と同じSSOT・ヘルパー・ルートを再利用する。
-# 新しい募集判定やエントリー登録処理はここでは実装しない。
- event_open = @event.event_end_time > Time.now
.song-participation
  .song-participation__header
    - if @song.recruiting?
      %span.badge.badge-warning 募集中!!
    - else
      %span.badge.badge-success 楽曲成立🎵
    - if @song.performance_start_time.present?
      %span.song-start-time
        = "開始 #{@song.performance_start_time}"

  - if @event.event_entry_deadline.present?
    %p.song-participation__deadline
      参加締切日:
      = l @event.event_entry_deadline, format: :short
      まで

  - if @song.join_parts.blank?
    %p.song-participation__empty このイベントには参加パートが設定されていません。
  - else
    = form_tag(public_event_join_confirm_path(@event), method: :get, id: "join_btn", onSubmit: "return CheckJoin()") do
      .song-participation__parts
        - @song.join_parts.each do |join_part|
          -# active_customers(customers.active)はloadedな関連でも再クエリするため、
          -# preload済みのjoin_part.customersからis_deletedを除外してN+1を避ける(events/show.html.hamlと同じ書き方)。
          - part_members = join_part.customers.reject(&:is_deleted)
          .song-part
            %span.song-part__name= join_part.join_part_name

            - if part_members.any?
              .song-part__members
                - part_members.each do |member|
                  .song-part__member
                    = link_to public_customer_path(member), class: "song-part__member-link", data: { turbolinks: false } do
                      = customer_avatar_tag(member, class_name: "icon_mini")
                      %span.song-part__member-name= member.name
                    - if member == current_customer && part_members.include?(current_customer) && @event.event_start_time > Time.current + 7.days
                      = link_to "取消",
                        public_event_delete_path(@event, join_part_id: join_part.id, customer_id: member.id),
                        method: :delete,
                        data: { turbolinks: false, confirm: "この参加をキャンセルしますか？" },
                        class: "btn btn-sm btn-danger song-part__cancel"
            - else
              %span.text-danger 募集中

            -# 経験者候補は一覧画面と同じPerformanceHistory::ExperiencedCustomersQuery/ヘルパーを再利用する。
            - candidates = experienced_customers_for_display(@song, join_part.join_part_name, exclude_customer_ids: part_members.map(&:id))
            = render "public/events/experienced_customers", customers: candidates

            - if @can_join_event && event_open
              .song-part__entry
                = label_tag "event_join_part_ids_#{join_part.id}", class: "song-part__entry-label" do
                  = check_box_tag "event[join_part_ids][]", join_part.id, false, id: "event_join_part_ids_#{join_part.id}", class: "js-join-part-checkbox"
                  このパートにエントリーする

      - if event_open
        - if @can_join_event
          %input#submit_join_form.btn.btn-lg.btn-primary.btn-block.song-participation__submit{
            type: "submit",
            value: "参加確認画面へ",
            disabled: true,
            data: { disable_with: "送信中...", turbolinks: false }
          }
        - else
          .song-participation__join-community
            %p 参加するには、開催コミュニティへの参加が必要です。
            = link_to "まずこちらのコミュニティに参加してください", public_community_path(@event.community), data: { turbolinks: false }, class: "btn btn-outline-info"
      - else
        %p.song-participation__closed 終了イベントのためチェック不可

  %div{type: "text/javascript"}
    :javascript
      function CheckJoin(){
        if(confirm("参加申請しますか？")){
          return true;
        }else{
          alert('キャンセルされました');
          location.reload();
          return false;
        }
      }
