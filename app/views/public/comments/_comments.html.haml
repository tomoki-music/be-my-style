- comments = activity.comments.order(created_at: :desc)

- comments.each do |comment|
  .comment-content
    .commenter-image
      = customer_avatar_link(comment.customer, class_name: "icon_mini")
    .comment-info
      .comment-upper
        .comment-name
          = customer_profile_name_link(comment.customer)
        .comment-time
          = time_ago_in_words(comment.created_at) + "前"
        .comment-delete
          - if comment.customer == current_customer
            = link_to '削除', public_activity_comment_path(comment.activity, comment), method: :delete, remote: true, class: "btn btn-danger", data: { 'turbolinks': false, confirm: "本当に削除しますか？" }
      .comment-beneath
        - if comment.stamped?
          = render "shared/stamp_display", stamp: comment
        - else
          = comment.comment
        %br
