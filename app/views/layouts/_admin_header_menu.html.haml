-# 未確認のご意見・ご相談件数。スマホ/PC 両メニュー・一覧画面で共有し、1リクエストにつき1回だけ COUNT する。
- customer_feedback_unread_count = admin_unread_customer_feedback_count
.row.justify-content-center
  .col-md-8
    %h2.text-center
      管理者ダッシュボード
  .col-md-2
    #admin-open
      = image_tag asset_path("mmm"), class: "icon_mini sp-menu-open"
.admin-menu-sp
  #admin-close
    %span.fa.fa-times.close-icon
      閉じる
  %ul.list-style-none
    - if admin_signed_in?
      %li
        = link_to "Topページ", admin_homes_top_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to "コミュニティ", admin_communities_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to "活動報告", admin_activities_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to "イベント", admin_events_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to "活動コメント", admin_activity_comments_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to "イベントコメント", admin_event_comments_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to admin_customer_feedbacks_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn" do
          ご意見BOX
          - if customer_feedback_unread_count.positive?
            %span.badge.badge-danger.ml-1= customer_feedback_unread_count
      %li
        = link_to "分析", admin_analytics_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        = link_to "🎛 Recap Health", health_admin_singing_recap_movies_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"
      %li
        %i.fa-solid.fa-right-from-bracket
        = link_to "管理者ログアウト", destroy_admin_session_path, method: :delete, class: "btn btn-secondary", data: { 'turbolinks': false }
    - else
      %li
        %i.fa-solid.fa-right-to-bracket
        = link_to "管理者ログイン", new_admin_session_path, class: "btn btn-primary", data: { 'turbolinks': false }
      %li
        = link_to "Topページ", admin_homes_top_path, data: { 'turbolinks': false }, class: "btn btn-secondary menu-sp-btn"

