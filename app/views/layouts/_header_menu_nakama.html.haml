.header_container.header_container--business.sticky-top
  .header-menu
    .row
      .col-7
        .top-message
          = link_to business_root_path, class: "top-message-link", data: { turbolinks: false } do
            = image_tag "nakama_logo.jpg", class: "top-message-image"
            %h1 NAKAMA
          %p ビジネスを加速させるコミュニティ

      .col-5
        -# 右上ユーティリティ: 通知ベル / ユーザーアイコン / (SPのみ)ハンバーガー。
        -# PC はユーザーアイコンでアカウントメニュー(dropdown)を開き、SP はアイコンをプロフィール(未ログインはログイン)へのリンクにして、
        -# アカウント項目は☰のメニューにまとめる。
        .business-header-utils
          - if customer_signed_in?
            - unread_count = business_unread_notification_count
            = link_to business_notifications_path,
              class: "business-header-bell",
              data: { turbolinks: false },
              "aria-label": unread_count.positive? ? "通知（未読#{unread_count}件）" : "通知" do
              %i.fa-regular.fa-bell{ "aria-hidden": "true" }
              - if unread_count.positive?
                %span.business-header-bell__badge= business_unread_badge_label(unread_count)

          .dropdown.business-account-menu
            %button.business-account-menu__toggle{ type: "button",
              id: "businessAccountMenuToggle",
              data: { toggle: "dropdown", display: "static" },
              "aria-haspopup": "true",
              "aria-expanded": "false",
              "aria-label": "アカウントメニュー" }
              = business_account_icon(current_customer)
            .dropdown-menu.dropdown-menu-right.business-account-menu__panel{ "aria-labelledby": "businessAccountMenuToggle" }
              - if customer_signed_in?
                .dropdown-header.business-account-menu__name= current_customer.name
                = link_to "プロフィール", business_customer_path(current_customer), class: "dropdown-item"
                = link_to "プロフィール設定", edit_business_customer_path(current_customer), class: "dropdown-item"
                = link_to "通知", business_notifications_path, class: "dropdown-item", data: { turbolinks: false }
                .dropdown-divider
                -# キーボード操作のため input ではなく button で出す（DELETE / CSRF は button_to が担保）。
                = button_to destroy_customer_session_path,
                  method: :delete,
                  form_class: "business-account-menu__logout-form",
                  class: "dropdown-item business-account-menu__logout" do
                  ログアウト
              - else
                = link_to "ログイン", new_business_customer_session_path, class: "dropdown-item"
                = link_to "新規登録", new_business_customer_registration_path, class: "dropdown-item"

          - if customer_signed_in?
            = link_to business_customer_path(current_customer), class: "business-account-link", "aria-label": "プロフィール" do
              = business_account_icon(current_customer)
          - else
            = link_to new_business_customer_session_path, class: "business-account-link", "aria-label": "ログイン" do
              = business_account_icon(nil)

          %button#open.header-menu-toggle{ type: "button",
            "aria-expanded": "false",
            "aria-controls": "businessSpMenu",
            "aria-label": "メニューを開く" }
            %i.fa-solid.fa-bars{ "aria-hidden": "true" }
            %span.header-menu-toggle__label メニュー

  / =========================
  / スマホメニュー(☰): サイト内の移動 + アカウント
  / =========================
  %nav.customer-menu-sp#businessSpMenu{ "aria-label": "メニュー", data: { "business-sp-menu" => "true" } }
    %button#close.business-sp-menu__close{ type: "button", "aria-label": "メニューを閉じる" }
      %span.fa.fa-times{ "aria-hidden": "true" }
      閉じる

    %ul.list-style-none.business-sp-menu__list
      %li
        = link_to "HOME", business_root_path, class: "btn btn-primary menu-sp-btn"
      - if customer_signed_in?
        %li
          = link_to "タイムライン", business_timeline_path, class: "btn btn-primary menu-sp-btn"
        %li
          = link_to "コミュニティ", business_communities_path, class: "btn btn-primary menu-sp-btn"
        %li
          = link_to business_posts_path, class: "btn btn-primary menu-sp-btn #{'menu-sp-btn-locked' unless feature_available?(:business_post_create)}" do
            投稿
            - unless feature_available?(:business_post_create)
              %span.menu-lock-note= feature_locked_badge(:business_post_create)
        -# プロジェクト作成の可否はコミュニティごとのお試し設定で変わるため、共通メニューではプラン案内を出さない
        %li
          = link_to "プロジェクト", business_projects_path, class: "btn btn-primary menu-sp-btn"

    %p.business-sp-menu__heading アカウント
    %ul.list-style-none.business-sp-menu__list
      - if customer_signed_in?
        %li.business-sp-menu__name= current_customer.name
        %li
          = link_to "プロフィール", business_customer_path(current_customer), class: "btn btn-outline-light menu-sp-btn"
        %li
          = link_to "プロフィール設定", edit_business_customer_path(current_customer), class: "btn btn-outline-light menu-sp-btn"
        %li
          = link_to business_notifications_path, class: "btn btn-outline-light menu-sp-btn", data: { turbolinks: false } do
            通知
            - if unread_count.positive?
              %span.business-sp-menu__badge{ "aria-label": "未読#{unread_count}件" }= business_unread_badge_label(unread_count)
        %li
          = button_to destroy_customer_session_path,
            method: :delete,
            form_class: "business-sp-menu__logout-form",
            class: "btn btn-outline-danger menu-sp-btn business-sp-menu__logout" do
            ログアウト
      - else
        %li
          = link_to "ログイン", new_business_customer_session_path, class: "btn btn-outline-light menu-sp-btn"
        %li
          = link_to "新規登録", new_business_customer_registration_path, class: "btn btn-success menu-sp-btn"


  / =========================
  / PCメニュー
  / =========================
  -# ログイン / ログアウト / プロフィールは右上のアカウントメニューへ集約している。
  .customer-menu-pc
    %ul.list-style-none.list

      - if customer_signed_in?

        %li
          = link_to "HOME", business_root_path, class: "menu-btn"

        %li
          = link_to "タイムライン",
            business_timeline_path,
            class:"menu-btn"

        %li
          = link_to "コミュニティ", business_communities_path, class: "menu-btn"

        %li
          = link_to business_posts_path, class: "menu-btn #{'menu-btn-locked' unless feature_available?(:business_post_create)}" do
            投稿
            - unless feature_available?(:business_post_create)
              %span.menu-lock-note= feature_locked_badge(:business_post_create)

        %li
          = link_to "プロジェクト", business_projects_path, class: "menu-btn"

      - else

        %li
          = link_to "HOME", business_root_path, class: "menu-btn"
