#!/bin/bash
# 新しい秘密値を /etc/be-my-style/puma.env に登録する。値は画面・引数・履歴に出さない。
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
F=/etc/be-my-style/puma.env
K="${1:-}"; RESTART="${2:-}"
case "$K" in
  OPENAI_API_KEY|LINE_CHANNEL_SECRET|LINE_CHANNEL_ACCESS_TOKEN|BUSINESS_MAIL_SENDER_ENABLED|BUSINESS_SMTP_ADDRESS|BUSINESS_SMTP_PORT|BUSINESS_SMTP_USER_NAME|BUSINESS_SMTP_PASSWORD) ;;
  BMS_SELFTEST_DUMMY) F=/etc/be-my-style/selftest.env; RESTART="" ;;  # 検証用。本番設定には書かない
  *) echo "使い方: sudo bms-set-secret <設定名> [--restart]"; exit 2;;
esac
read -rs -p "$K の新しい値を貼り付けて Enter（画面には出ません）: " V; echo
read -rs -p "確認のため、もう一度貼り付けて Enter: " V2; echo
[ -n "$V" ] || { echo "空のため変更していません"; exit 1; }
[ "$V" = "$V2" ] || { echo "2回の入力が一致しないため変更していません"; exit 1; }
case "$V" in *[[:space:]\"\'\\]*) echo "空白・引用符・バックスラッシュを含むため変更していません"; exit 1;; esac
[ -f "$F" ] || install -m 600 -o root -g root /dev/null "$F"
install -m 600 -o root -g root "$F" "$F.prev"
printf '%s' "$V" | python3 -c '
import sys, os
k, f = sys.argv[1], sys.argv[2]
v = sys.stdin.read()
lines = [l for l in open(f).read().splitlines() if not l.startswith(k + "=")]
lines.append(k + "=" + v)
tmp = f + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as h: h.write("\n".join(lines) + "\n")
os.replace(tmp, f)
' "$K" "$F"
unset V V2
echo "$K を更新しました（1つ前の内容は $F.prev に権限600で保存）。"
if [ "$RESTART" = "--restart" ]; then
  systemctl restart puma
  for i in $(seq 1 30); do sleep 2; systemctl is-active --quiet puma && break; done
  echo "Puma: $(systemctl is-active puma)"
else
  echo "反映には Puma の再起動が必要です（sudo systemctl restart puma）。"
fi
