#!/usr/bin/env python3
# 秘密値の疎通を状態コードだけで確認する。値は出力しない。
import os, sys, json, hmac, hashlib, base64, urllib.request, urllib.error, urllib.parse
if os.geteuid() != 0: os.execvp("sudo", ["sudo", sys.argv[0]] + sys.argv[1:])
env = {}
for l in open("/etc/be-my-style/puma.env"):
    l = l.rstrip("\n")
    if "=" in l and not l.startswith("#"): k, v = l.split("=", 1); env[k] = v
def req(url, headers=None, data=None, method=None):
    r = urllib.request.Request(url, data=data, headers=headers or {}, method=method)
    try:
        with urllib.request.urlopen(r, timeout=15) as resp: return resp.status, resp.read()
    except urllib.error.HTTPError as e: return e.code, e.read()
    except Exception as e: return "ERR:" + type(e).__name__, b""
want = sys.argv[1:] or ["openai", "line_token", "line_webhook"]
if "openai" in want:
    k = env.get("OPENAI_API_KEY", "")
    s, _ = req("https://api.openai.com/v1/models", {"Authorization": "Bearer " + k})
    print(f"openai: key_length={len(k)} GET /v1/models -> {s}")
if "line_token" in want:
    t = env.get("LINE_CHANNEL_ACCESS_TOKEN", "")
    s, _ = req("https://api.line.me/v2/bot/info", {"Authorization": "Bearer " + t})
    print(f"line_token: length={len(t)} GET /v2/bot/info -> {s}")
    s, b = req("https://api.line.me/v2/oauth/verify", {"Content-Type": "application/x-www-form-urlencoded"}, urllib.parse.urlencode({"access_token": t}).encode())
    try: j = json.loads(b or b"{}")
    except Exception: j = {}
    exp = j.get("expires_in")
    print(f"line_token: verify -> {s} expires_in_days={'n/a' if exp is None else round(int(exp)/86400, 1)}")
if "line_webhook" in want:
    sec = env.get("LINE_CHANNEL_SECRET", "")
    body = json.dumps({"destination": "bms-verify", "events": []}).encode()
    sig = base64.b64encode(hmac.new(sec.encode(), body, hashlib.sha256).digest()).decode()
    url = "https://be-my-style.com/learning/line/webhook"
    s1, _ = req(url, {"Content-Type": "application/json", "X-Line-Signature": sig}, body)
    s2, _ = req(url, {"Content-Type": "application/json", "X-Line-Signature": "invalid"}, body)
    print(f"line_webhook: secret_length={len(sec)} signed -> {s1} / wrong_signature -> {s2}")
